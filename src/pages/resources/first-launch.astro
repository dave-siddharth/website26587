---
import Base from '../../layouts/Base.astro';

const handbook = 'https://docs.google.com/document/d/1APZgrkhzuPZfGMQBbp1shnXP79ZArBHLWSkaUH4tG20/edit?tab=t.0';
const discord = 'https://discord.gg/mzqH3Dqv6j';
---
<Base title="FIRST LAUNCH · Triple Six FTC 26587">
  <section class="fl-hero">
    <div class="shell">
      <p class="eyebrow">Rookie Team Support</p>
      <h1>FIRST<br /><span>LAUNCH.</span></h1>
      <p class="intro">
        A cross-border FTC community created by FTC 12560, FTC 26587 and FTC 30686
        to make the rookie season easier to navigate.
      </p>

      <div class="actions">
        <a href={handbook} target="_blank" rel="noreferrer">
          <span class="action-icon docs">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h6"/></svg>
          </span>
          <span>Read the FTC Rookie Handbook</span>
        </a>
        <a href={discord} target="_blank" rel="noreferrer">
          <span class="action-icon discord">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 8.5c1.1-.8 2.2-1.1 3.5-1.1 1.3 0 2.4.3 3.5 1.1M8 16.5c1.2.9 2.5 1.3 4 1.3s2.8-.4 4-1.3"/><path d="M7 18c-2.2-1.2-3.5-3.6-3.5-6 0-3.9 3.6-7 8.5-7s8.5 3.1 8.5 7c0 2.4-1.3 4.8-3.5 6l-1-.9"/><circle cx="9.5" cy="12" r="1"/><circle cx="14.5" cy="12" r="1"/></svg>
          </span>
          <span>Join our Discord</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section fl-content">
    <div class="shell content-grid">
      <div>
        <p class="eyebrow">The handbook</p>
        <h2>Start with a map.</h2>
      </div>
      <p>
        The FTC Rookie Handbook is a practical guide to starting, building, competing
        and growing in FIRST Tech Challenge. It covers the first 30 days, rules and
        inspection, hardware, drivetrains, programming, CAD, testing, team operations,
        judging, outreach, budgeting, grants, sponsorship and event readiness.
      </p>
    </div>
  </section>

  <section class="section discord-panel">
    <div class="shell content-grid">
      <div>
        <p class="eyebrow">The community</p>
        <h2>Don’t learn alone.</h2>
      </div>
      <div>
        <p>
          The FIRST LAUNCH Discord gives new and developing teams a place to ask questions,
          compare approaches and connect with students and mentors across multiple FTC regions.
        </p>
        <a class="discord-link" href={discord} target="_blank" rel="noreferrer">Join our Discord ↗</a>
      </div>
    </div>
  </section>
</Base>

<style>
.fl-hero {
  padding: clamp(90px, 11vw, 150px) 0 clamp(76px, 9vw, 118px);
  background:
    radial-gradient(circle at 15% 20%, rgba(202,255,50,.075), transparent 27%),
    radial-gradient(circle at 88% 80%, rgba(17,207,224,.07), transparent 32%),
    var(--surface-0);
}

.fl-hero h1 {
  margin: 14px 0 0;
  font-size: clamp(5rem, 13vw, 12rem);
  line-height: .75;
  letter-spacing: -.09em;
}

.fl-hero h1 span {
  background: linear-gradient(90deg, #caff32, #70e681, #11cfe0);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.intro {
  max-width: 820px;
  margin: 38px 0 0;
  color: var(--muted);
  font-size: clamp(1.1rem, 2vw, 1.35rem);
  line-height: 1.75;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
  margin-top: 34px;
}

.actions a,
.discord-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  min-height: 48px;
  padding: 0 16px;
  border: 1px solid rgba(112,230,129,.22);
  background: var(--panel-bg);
  color: var(--text);
  font-size: .78rem;
  font-weight: 820;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.action-icon {
  display: inline-grid;
  place-items: center;
  width: 22px;
  height: 22px;
  flex: none;
}

.action-icon svg {
  width: 22px;
  height: 22px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.action-icon.docs {
  color: var(--green);
}

.action-icon.discord {
  color: var(--cyan);
}

.content-grid {
  display: grid;
  grid-template-columns: .82fr 1.18fr;
  gap: clamp(42px, 8vw, 110px);
}

.content-grid h2 {
  margin: 0;
  font-size: clamp(3rem, 6vw, 5.8rem);
  line-height: .92;
  letter-spacing: -.065em;
}

.content-grid > p,
.content-grid > div:last-child p {
  max-width: 680px;
  margin: 0;
  color: var(--muted);
  font-size: 1.06rem;
  line-height: 1.8;
}

.discord-panel {
  background:
    radial-gradient(circle at 100% 100%, rgba(17,207,224,.055), transparent 34%),
    var(--surface-1);
}

.discord-link {
  margin-top: 26px;
}

@media (max-width: 800px) {
  .content-grid {
    grid-template-columns: 1fr;
  }
}
</style>
