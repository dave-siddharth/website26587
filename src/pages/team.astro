---
import Base from '../layouts/Base.astro';

const members = [
  { name: 'Siddharth D', role: 'CAD / Programming / Portfolio / Driver', image: '/images/team/siddharth-d.png' },
  { name: 'Yuteng W', role: 'Finance / Build', image: '/images/team/yuteng-w.png' },
  { name: 'William R', role: 'Outreach / Build', image: '/images/team/william-r.png' },
];
const mentors = [
  { name: 'Kinjal Dave', role: 'Mentor', image: '/images/team/kinjal-dave.png' },
  { name: 'Isha Dave', role: 'Mentor', image: '/images/team/isha-dave.png' },
];
---
<Base title="Team — Triple Six FTC 26587">
  <section class="page-hero">
    <div class="shell">
      <p class="kicker">The team</p>
      <h1>About Triple Six</h1>
      <p class="lede">Triple Six is a three-student FTC team based in Cambridge, UK. Every member owns part of the robot and part of the team beyond the robot.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="kicker">Members</p>
      <h2 class="section-title">Who is on the team</h2>
      <div class="people-grid">
        {members.map((member) => (
          <article class="person">
            <img src={member.image} alt={member.name} loading="lazy" />
            <h3>{member.name}</h3>
            <p>{member.role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section team-photo-section">
    <div class="shell team-photo-grid">
      <div>
        <p class="kicker">Together</p>
        <h2 class="section-title">Small team.<br />Shared responsibility.</h2>
      </div>
      <img src="/images/team/team-group.png" alt="Triple Six team group photo" />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="kicker">Mentors</p>
      <h2 class="section-title">Who we learn from</h2>
      <div class="mentor-list">
        {mentors.map((mentor) => (
          <article class="mentor-row">
            <img src={mentor.image} alt={mentor.name} loading="lazy" />
            <div><h3>{mentor.name}</h3><p>{mentor.role}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
.people-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 220px));
  gap: 38px;
  margin-top: 48px;
  justify-content: start;
}

.person {
  max-width: 220px;
}

.person img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  background: #090b0d;
}

.person h3 {
  margin: 14px 0 4px;
  font-size: 1.18rem;
  letter-spacing: -.025em;
}

.person p {
  margin: 0;
  color: var(--muted);
  font-size: .84rem;
  line-height: 1.55;
}

.team-photo-grid {
  display: grid;
  grid-template-columns: .7fr 1.3fr;
  gap: clamp(40px, 8vw, 100px);
  align-items: start;
}

.team-photo-grid img {
  width: 100%;
  max-height: 560px;
  object-fit: cover;
}

.mentor-list {
  margin-top: 42px;
  border-top: 1px solid var(--line);
  max-width: 760px;
}

.mentor-row {
  display: grid;
  grid-template-columns: 76px 1fr;
  gap: 22px;
  align-items: center;
  padding: 20px 0;
  border-bottom: 1px solid var(--line);
}

.mentor-row img {
  width: 76px;
  height: 76px;
  object-fit: cover;
}

.mentor-row h3 {
  margin: 0 0 4px;
  font-size: 1.24rem;
  letter-spacing: -.025em;
}

.mentor-row p {
  margin: 0;
  color: var(--muted);
  font-size: .84rem;
}

@media (max-width: 800px) {
  .people-grid {
    grid-template-columns: repeat(2, minmax(0, 180px));
    gap: 28px;
  }

  .person {
    max-width: 180px;
  }

  .team-photo-grid {
    grid-template-columns: 1fr;
  }

  .mentor-row {
    grid-template-columns: 64px 1fr;
  }

  .mentor-row img {
    width: 64px;
    height: 64px;
  }
}

@media (max-width: 480px) {
  .people-grid {
    grid-template-columns: 1fr;
  }
}
</style>