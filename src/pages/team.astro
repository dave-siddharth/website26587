---
import Base from '../layouts/Base.astro';

const members = [
  { name: 'Siddharth D', role: 'CAD / Programming / Portfolio / Driver', image: '/images/team/siddharth-d.png' },
  { name: 'Yuteng W', role: 'Finance / Build', image: '/images/team/yuteng-w.png' },
  { name: 'William R', role: 'Outreach / Build', image: '/images/team/william-r.png' },
];
const mentors = [
  { name: 'Kinjal Dave', role: 'Mentor', image: '/images/team/kinjal-dave.png' },
  { name: 'Isha Dave', role: 'Mentor', image: '/images/team/isha-dave.png' },
];
---
<Base title="Team — Triple Six FTC 26587">
  <section class="page-hero">
    <div class="shell">
      <p class="kicker">The team</p>
      <h1>About Triple Six</h1>
      <p class="lede">Triple Six is a three-student FTC team based in Cambridge, UK. Every member owns part of the robot and part of the team beyond the robot.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="kicker">Members</p>
      <h2 class="section-title">Who is on the team</h2>
      <div class="people-grid">
        {members.map((member) => (
          <article class="person">
            <img src={member.image} alt={member.name} loading="lazy" />
            <h3>{member.name}</h3>
            <p>{member.role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section team-photo-section">
    <div class="shell team-photo-grid">
      <div>
        <p class="kicker">Together</p>
        <h2 class="section-title">Small team.<br />Shared responsibility.</h2>
      </div>
      <img src="/images/team/team-group.png" alt="Triple Six team group photo" />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="kicker">Mentors</p>
      <h2 class="section-title">Who we learn from</h2>
      <div class="mentor-list">
        {mentors.map((mentor) => (
          <article class="mentor-row">
            <img src={mentor.image} alt={mentor.name} loading="lazy" />
            <div><h3>{mentor.name}</h3><p>{mentor.role}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
.people-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:48px; }
.person img { width:100%; aspect-ratio:4/5; object-fit:cover; background:#090b0d; }
.person h3 { margin:18px 0 5px; font-size:1.45rem; letter-spacing:-.03em; }
.person p { margin:0; color:var(--muted); }
.team-photo-grid { display:grid; grid-template-columns:.65fr 1.35fr; gap:clamp(40px,8vw,100px); align-items:start; }
.team-photo-grid img { width:100%; max-height:650px; object-fit:cover; }
.mentor-list { margin-top:50px; border-top:1px solid var(--line); }
.mentor-row { display:grid; grid-template-columns:120px 1fr; gap:28px; align-items:center; padding:26px 0; border-bottom:1px solid var(--line); }
.mentor-row img { width:120px; height:120px; object-fit:cover; }
.mentor-row h3 { margin:0 0 6px; font-size:1.6rem; letter-spacing:-.03em; }
.mentor-row p { margin:0; color:var(--muted); }
@media(max-width:800px){.people-grid{grid-template-columns:1fr}.team-photo-grid{grid-template-columns:1fr}.mentor-row{grid-template-columns:90px 1fr}.mentor-row img{width:90px;height:90px}}
</style>