---
import Base from '../layouts/Base.astro';

const members = [
  {
    name: 'Siddharth D',
    role: 'CAD / Programming / Portfolio / Driver',
    image: '/images/team/siddharth-d.png'
  },
  {
    name: 'Yuteng W',
    role: 'Finance / Build',
    image: '/images/team/yuteng-w.png'
  },
  {
    name: 'William R',
    role: 'Outreach / Build',
    image: '/images/team/william-r.png'
  },
];

const mentors = [
  {
    name: 'Kinjal Dave',
    role: 'Mentor',
    affiliation: 'Arm Holdings · Cambridge STEAM Lab',
    image: '/images/team/kinjal-dave.png'
  },
  {
    name: 'Isha Dave',
    role: 'Mentor',
    affiliation: 'Cambridge STEAM Lab · Dave Academy',
    image: '/images/team/isha-dave.png'
  },
  {
    name: 'Ryan Ganguli',
    role: 'Mentor',
    affiliation: 'FRC 1884 Alum · FTC 19280 Alum',
    detail: 'Mechatronic Engineering · University of Sheffield',
    image: '/images/team/ryan-ganguli.jpg'
  },
  {
    name: 'Kshitij Dubey',
    role: 'Mentor',
    affiliation: 'FTC 27891 Alum · St Paul’s School',
    image: '/images/team/kshitij-dubey.jpg'
  },
];
---
<Base title="Team — Triple Six FTC 26587">
  <section class="page-hero">
    <div class="shell">
      <p class="kicker">The team</p>
      <h1>About Triple Six</h1>
      <p class="lede">
        Triple Six is a three-student FTC team based in Cambridge, UK.
        Every member owns part of the robot and part of the team beyond the robot.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="kicker">Members</p>
      <h2 class="section-title">Who is on the team</h2>

      <div class="people-grid">
        {members.map((member) => (
          <article class="person">
            <img src={member.image} alt={member.name} loading="lazy" />
            <h3>{member.name}</h3>
            <p>{member.role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section team-photo-section">
    <div class="shell team-photo-grid">
      <div>
        <p class="kicker">Together</p>
        <h2 class="section-title">Small team.<br />Shared responsibility.</h2>
      </div>

      <img src="/images/team/team-group.png" alt="Triple Six team group photo" />
    </div>
  </section>

  <section class="section mentors-section">
    <div class="shell">
      <p class="kicker">Mentors</p>
      <h2 class="section-title">Who we learn from</h2>

      <div class="mentor-list">
        {mentors.map((mentor) => (
          <article class="mentor-row">
            <img src={mentor.image} alt={mentor.name} loading="lazy" />

            <div class="mentor-copy">
              <p class="mentor-label">{mentor.role}</p>
              <h3>{mentor.name}</h3>
              <p class="mentor-affiliation">{mentor.affiliation}</p>
              {mentor.detail && <p class="mentor-detail">{mentor.detail}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
.people-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28px;
  margin-top: 48px;
}

.person {
  max-width: none;
}

.person img {
  width: 100%;
  border: 1px solid rgba(112,230,129,.18);
  box-shadow: 0 14px 36px rgba(17,207,224,.05);
  aspect-ratio: 4 / 5;
  object-fit: cover;
  background: var(--surface-2);
}

.person h3 {
  margin: 16px 0 5px;
  font-size: 1.35rem;
  letter-spacing: -.03em;
}

.person p {
  margin: 0;
  color: var(--muted);
  font-size: .9rem;
  line-height: 1.55;
}

.team-photo-grid {
  display: grid;
  grid-template-columns: .7fr 1.3fr;
  gap: clamp(40px, 8vw, 100px);
  align-items: start;
}

.team-photo-grid img {
  width: 100%;
  max-height: 560px;
  object-fit: cover;
}

.mentors-section {
  background:
    radial-gradient(circle at 100% 0%, rgba(17,207,224,.035), transparent 30%);
}

.mentor-list {
  margin-top: 42px;
  border-top: 1px solid var(--line);
}

.mentor-row {
  position: relative;
  display: grid;
  grid-template-columns: 130px 1fr;
  gap: 28px;
  align-items: center;
  min-height: 180px;
  padding: 25px 0;
  border-bottom: 1px solid var(--line);
}

.mentor-row::before {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 0;
  height: 1px;
  background: var(--accent-gradient);
  transition: width .25s ease;
}

.mentor-row:hover::before {
  width: 100%;
}

.mentor-row img {
  width: 130px;
  height: 130px;
  object-fit: cover;
  border: 1px solid rgba(17,207,224,.22);
  background: var(--surface-2);
}

.mentor-copy {
  max-width: 760px;
}

.mentor-label {
  margin: 0 0 7px;
  background: var(--accent-gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-size: .64rem;
  font-weight: 830;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.mentor-row h3 {
  margin: 0 0 8px;
  font-size: clamp(1.5rem, 2.4vw, 2.15rem);
  letter-spacing: -.04em;
}

.mentor-affiliation {
  margin: 0;
  color: var(--text);
  font-size: .92rem;
  line-height: 1.55;
}

.mentor-detail {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: .88rem;
  line-height: 1.55;
}

@media (max-width: 800px) {
  .people-grid {
    grid-template-columns: 1fr 1fr;
  }

  .team-photo-grid {
    grid-template-columns: 1fr;
  }

  .mentor-row {
    grid-template-columns: 100px 1fr;
    gap: 20px;
  }

  .mentor-row img {
    width: 100px;
    height: 100px;
  }
}

@media (max-width: 520px) {
  .people-grid {
    grid-template-columns: 1fr;
  }

  .mentor-row {
    grid-template-columns: 80px 1fr;
  }

  .mentor-row img {
    width: 80px;
    height: 80px;
  }
}
</style>
