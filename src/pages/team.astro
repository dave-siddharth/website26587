---
import Base from '../layouts/Base.astro';

const members = [
  {
    name: 'Siddharth D',
    role: 'CAD / Programmer · Portfolio · Driver',
    image: '/images/team/siddharth-d.png',
  },
  {
    name: 'Yuteng W',
    role: 'Finance & Build',
    image: '/images/team/yuteng-w.png',
  },
  {
    name: 'William R',
    role: 'Outreach & Build',
    image: '/images/team/william-r.png',
  },
];
---
<Base title="Team · Triple Six FTC 26587">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">FTC 26587</p>
      <h1>THE <span class="gradient-text">TEAM.</span></h1>
      <p class="lede">Three students. One team. Built around engineering, competition and impact.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell team-list">
      {members.map((member, index) => (
        <article class="member">
          <div class="member-image">
            {member.image ? (
              <img src={member.image} alt={`${member.name} — Triple Six FTC 26587`} loading="lazy" />
            ) : (
              <div class="photo-placeholder">Portrait to add</div>
            )}
          </div>

          <div class="member-info">
            <span class="member-number">{String(index + 1).padStart(2, '0')}</span>
            <h2>{member.name}</h2>
            <p class="role">{member.role}</p>
          </div>
        </article>
      ))}
    </div>
  </section>



  <section class="section team-group-section">
    <div class="shell">
      <p class="eyebrow">Group Photo</p>
      <div class="team-group-photo">
        <img src="/images/team/team-group.png" alt="Triple Six team group photo" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section mentor-section">
    <div class="shell">
      <p class="eyebrow">Mentors</p>

      <div class="mentor-grid">
        <article class="mentor">
          <div class="mentor-image">
            <img src="/images/team/kinjal-dave.png" alt="Kinjal Dave — Triple Six mentor" loading="lazy" />
          </div>

          <div class="mentor-info">
            <span class="member-number">MENTOR</span>
            <h2>Kinjal Dave</h2>
            <p class="role">Mentor</p>
          </div>
        </article>

        <article class="mentor">
          <div class="mentor-image">
            <img src="/images/team/isha-dave.png" alt="Isha Dave — Triple Six mentor" loading="lazy" />
          </div>

          <div class="mentor-info">
            <span class="member-number">MENTOR</span>
            <h2>Isha Dave</h2>
            <p class="role">Mentor</p>
          </div>
        </article>
      </div>
    </div>
  </section>

</Base>

<style>
.team-list {
  display: grid;
  gap: 88px;
}

.member {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr);
  gap: clamp(32px, 6vw, 88px);
  align-items: end;
}

.member:nth-child(even) .member-image {
  order: 2;
}

.member:nth-child(even) .member-info {
  order: 1;
}

.member-image {
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border-radius: 4px;
  background: #07101d;
}

.member-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 28%;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  border: 1px dashed rgba(255,255,255,.15);
  color: rgba(255,255,255,.25);
  font-size: .75rem;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.member-number {
  color: var(--lime);
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .2em;
}

.member h2 {
  margin: 12px 0 8px;
  font-size: clamp(3rem, 7vw, 6.5rem);
  line-height: .9;
  letter-spacing: -.06em;
}

.role {
  margin: 0;
  color: var(--muted);
  font-size: clamp(1rem, 2vw, 1.25rem);
  letter-spacing: .02em;
}

@media (max-width: 760px) {
  .member {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .member:nth-child(even) .member-image,
  .member:nth-child(even) .member-info {
    order: initial;
  }
}

.mentor-section {
  padding-top: 40px;
}

.mentor {
  display: grid;
  grid-template-columns: minmax(240px, .62fr) minmax(0, 1.38fr);
  gap: clamp(32px, 6vw, 88px);
  align-items: end;
}

.mentor-image {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 4px;
  background: #07101d;
}

.mentor-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mentor h2 {
  margin: 12px 0 8px;
  font-size: clamp(3rem, 7vw, 6.5rem);
  line-height: .9;
  letter-spacing: -.06em;
}

@media (max-width: 760px) {
  .mentor {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .mentor-image {
    max-width: 440px;
  }
}


.mentor-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 40px;
}

.mentor-grid .mentor {
  display: block;
}

.mentor-grid .mentor-image {
  aspect-ratio: 1 / 1;
  margin-bottom: 24px;
}

.mentor-grid .mentor h2 {
  font-size: clamp(2.5rem, 5vw, 4.8rem);
}

@media (max-width: 760px) {
  .mentor-grid {
    grid-template-columns: 1fr;
  }
}


.team-group-section {
  padding-top: 28px;
}

.team-group-photo {
  overflow: hidden;
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,.08);
  background: #05070d;
}

.team-group-photo img {
  width: 100%;
  height: auto;
  display: block;
}

</style>
