---
import Base from '../layouts/Base.astro';

const members = [
  { name: 'Siddharth D', role: 'CAD / Programmer · Portfolio · Driver' },
  { name: 'Yuteng W', role: 'Finance & Build' },
  { name: 'William R', role: 'Outreach & Build' },
];
---
<Base title="Triple Six · FTC 26587">
  <section class="hero">
    <div class="hero-image" aria-hidden="true">
      <img src="/images/team/team-group.png" alt="" />
    </div>
    <div class="hero-shade"></div>

    <div class="shell hero-content">
      <div class="hero-copy">
        <p class="eyebrow">FIRST Tech Challenge · Team 26587 · Cambridge, UK</p>
        <h1>TRIPLE SIX<br /><span class="gradient-text">BUILDING WHAT'S NEXT.</span></h1>
        <p class="hero-lede">
          A student-led robotics team designing, building and programming competitive FTC robots —
          while sharing what we learn with the wider community.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/robots">Explore our robots</a>
          <a class="button button-ghost" href="/team">Meet the team</a>
        </div>
      </div>
    </div>
  </section>

  <section class="support-strip">
    <div class="shell support-inner">
      <p>Supported by</p>
      <div class="support-logos">
        <a href="/sponsors" aria-label="Dave Academy sponsor">
          <img class="dave-logo" src="/images/sponsors/dave-academy-transparent.png" alt="Dave Academy" />
        </a>
        <a href="/sponsors" aria-label="Cambridge STEAM Lab sponsor">
          <img class="steam-logo" src="/images/sponsors/cambridge-steam-lab-transparent.png" alt="Cambridge STEAM Lab" />
        </a>
      </div>
      <a class="mini-link" href="/sponsors">Our sponsors →</a>
    </div>
  </section>

  <section class="section about-section">
    <div class="shell about-grid">
      <div>
        <p class="eyebrow">About us</p>
        <h2 class="section-title">Who we are</h2>
      </div>
      <div class="about-copy">
        <p class="big-copy">
          Triple Six is FTC Team 26587, a Cambridge-based community robotics team built around
          serious engineering, constant iteration and learning in public.
        </p>
        <p>
          Across mechanical design, software, build, portfolio, outreach and team operations,
          every member has a real area of responsibility. We use competition as a reason to make
          better machines — and outreach as a reason to make the knowledge useful beyond our own team.
        </p>
        <a class="text-link" href="/team">Meet Triple Six →</a>
      </div>
    </div>
  </section>

  <section class="section robot-feature">
    <div class="shell">
      <div class="feature-heading">
        <div>
          <p class="eyebrow">Engineering</p>
          <h2 class="section-title">Three seasons.<br />One evolving system.</h2>
        </div>
        <p class="feature-intro">
          From a mecanum-upgraded starter platform in INTO THE DEEP, through DECODE's turreted
          architecture, to BIOBUZZ preseason development, every robot becomes the starting point for the next.
        </p>
      </div>

      <a class="robot-panel" href="/robots">
        <div class="robot-panel-image">
          <img src="/images/robots/decode.png" alt="DECODE robot CAD render" />
        </div>
        <div class="robot-panel-copy">
          <span class="season">2025–2026 · DECODE</span>
          <h3>Designed for range.</h3>
          <p>
            A 240° turret, adjustable hood, five-stage intake and far-zone / close-zone compatibility
            built around a REV parallel-plate mecanum drivetrain.
          </p>
          <span class="text-link">Explore all robots →</span>
        </div>
      </a>

      <div class="robot-stats">
        <div><strong>3</strong><span>FTC seasons documented</span></div>
        <div><strong>240°</strong><span>DECODE turret travel</span></div>
        <div><strong>5</strong><span>intake stages on DECODE</span></div>
      </div>
    </div>
  </section>

  <section class="section team-preview">
    <div class="shell">
      <div class="team-heading">
        <div>
          <p class="eyebrow">The team</p>
          <h2 class="section-title">Three students.<br />Shared ownership.</h2>
        </div>
        <a class="text-link desktop-link" href="/team">Full team page →</a>
      </div>

      <div class="member-list">
        {members.map((member, index) => (
          <a class="member-row" href="/team">
            <span class="member-index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{member.name}</h3>
            <p>{member.role}</p>
            <span class="row-arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section outreach-feature">
    <div class="shell outreach-grid">
      <a class="outreach-image" href="/outreach">
        <img src="/images/outreach/scout-presentation.png" alt="Triple Six outreach presentation" />
      </a>
      <div class="outreach-copy">
        <p class="eyebrow">Beyond competition</p>
        <h2 class="section-title">Engineering is better when it is shared.</h2>
        <p>
          We take FTC beyond our own workshop through school presentations, community sessions,
          hands-on robotics activities, demonstrations and remote support.
        </p>
        <a class="text-link" href="/outreach">See our outreach →</a>
      </div>
    </div>
  </section>

  <section class="section sponsor-cta-section">
    <div class="shell sponsor-cta">
      <p class="eyebrow">Support the team</p>
      <h2>Help us build the<br /><span class="gradient-text">next iteration.</span></h2>
      <p>
        Sponsorship helps cover registration, robot development and the work we do beyond the competition field.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/sponsors">Meet our sponsors</a>
        <a class="button button-ghost" href="/contact">Get in touch</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 78px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #01030a;
  }

  .hero-image,
  .hero-shade {
    position: absolute;
    inset: 0;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    filter: saturate(.78) contrast(1.05) brightness(.62);
  }

  .hero-shade {
    background:
      linear-gradient(90deg, rgba(1,3,10,.98) 0%, rgba(1,3,10,.92) 38%, rgba(1,3,10,.46) 68%, rgba(1,3,10,.28) 100%),
      linear-gradient(0deg, #01030a 0%, transparent 36%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 120px;
    padding-bottom: clamp(72px, 9vw, 130px);
  }

  .hero-copy {
    max-width: 930px;
  }

  .hero h1 {
    margin: 0;
    max-width: 980px;
    font-size: clamp(4rem, 9.5vw, 9rem);
    font-weight: 820;
    line-height: .86;
    letter-spacing: -.075em;
  }

  .hero-lede {
    max-width: 690px;
    margin: 28px 0 0;
    color: #b7c1cc;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 22px;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 999px;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: transform .25s ease, border-color .25s ease, background .25s ease;
  }

  .button:hover { transform: translateY(-2px); }
  .button-primary {
    color: #031007;
    border-color: transparent;
    background: linear-gradient(90deg, var(--lime), var(--green), var(--cyan));
  }
  .button-ghost { background: rgba(2,5,13,.55); backdrop-filter: blur(10px); }
  .button-ghost:hover { border-color: rgba(201,255,45,.55); }

  .support-strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #01030a;
  }

  .support-inner {
    min-height: 116px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 34px;
  }

  .support-inner > p {
    margin: 0;
    color: #6f7a88;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .support-logos {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  .support-logos a { display: block; opacity: .7; transition: opacity .2s ease; }
  .support-logos a:hover { opacity: 1; }
  .support-logos img { object-fit: contain; }
  .dave-logo { width: 150px; max-height: 58px; }
  .steam-logo { width: 185px; max-height: 62px; filter: invert(1); }
  .mini-link { color: #9ca7b4; font-size: .78rem; font-weight: 700; }

  .about-grid {
    display: grid;
    grid-template-columns: .75fr 1.25fr;
    gap: clamp(50px, 8vw, 130px);
    align-items: start;
  }

  .about-copy { max-width: 760px; }
  .big-copy {
    margin: 0 0 28px;
    color: #f4f7f8;
    font-size: clamp(1.5rem, 3.1vw, 2.8rem);
    line-height: 1.22;
    letter-spacing: -.03em;
  }
  .about-copy > p:not(.big-copy) {
    max-width: 650px;
    margin: 0 0 26px;
    color: var(--muted);
    font-size: 1.06rem;
    line-height: 1.75;
  }

  .text-link {
    display: inline-flex;
    color: #eef4f6;
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .text-link:hover { color: var(--lime); }

  .feature-heading {
    display: grid;
    grid-template-columns: 1fr .85fr;
    gap: 60px;
    align-items: end;
    margin-bottom: 54px;
  }
  .feature-intro {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .robot-panel {
    min-height: 620px;
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #04070d;
  }

  .robot-panel-image {
    min-height: 620px;
    display: grid;
    place-items: center;
    padding: clamp(22px, 4vw, 58px);
    overflow: hidden;
    background:
      radial-gradient(circle at 40% 45%, rgba(96,232,118,.10), transparent 36%),
      #03060b;
  }

  .robot-panel-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: screen;
  }

  .robot-panel-copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(38px, 5vw, 70px);
    border-left: 1px solid var(--line);
  }
  .season {
    color: var(--lime);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .robot-panel-copy h3 {
    margin: 14px 0 18px;
    font-size: clamp(3rem, 6vw, 6.4rem);
    line-height: .9;
    letter-spacing: -.06em;
  }
  .robot-panel-copy p {
    max-width: 43ch;
    margin: 0 0 28px;
    color: var(--muted);
    line-height: 1.7;
  }

  .robot-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 18px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .robot-stats > div { padding: 30px 0; }
  .robot-stats > div + div { border-left: 1px solid var(--line); padding-left: 32px; }
  .robot-stats strong { display: block; font-size: clamp(2rem, 4vw, 3.8rem); letter-spacing: -.055em; }
  .robot-stats span { color: #7f8a98; font-size: .8rem; }

  .team-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 48px;
  }
  .member-list { border-top: 1px solid var(--line); }
  .member-row {
    display: grid;
    grid-template-columns: 58px 1fr 1fr 32px;
    gap: 28px;
    align-items: center;
    min-height: 112px;
    border-bottom: 1px solid var(--line);
    transition: padding .25s ease, background .25s ease;
  }
  .member-row:hover { padding-inline: 14px; background: rgba(255,255,255,.018); }
  .member-index { color: var(--lime); font-size: .7rem; letter-spacing: .18em; }
  .member-row h3 { margin: 0; font-size: clamp(1.6rem, 3.2vw, 3rem); letter-spacing: -.04em; }
  .member-row p { margin: 0; color: var(--muted); }
  .row-arrow { color: var(--lime); font-size: 1.1rem; }

  .outreach-grid {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: clamp(40px, 7vw, 100px);
    align-items: center;
  }
  .outreach-image {
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
  }
  .outreach-image img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    filter: saturate(.82) brightness(.82);
    transition: transform .6s ease, filter .4s ease;
  }
  .outreach-image:hover img { transform: scale(1.015); filter: saturate(.95) brightness(.9); }
  .outreach-copy p:not(.eyebrow) {
    max-width: 46ch;
    margin: 26px 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .sponsor-cta-section { padding-bottom: 140px; }
  .sponsor-cta {
    padding: clamp(46px, 8vw, 92px);
    border: 1px solid var(--line);
    border-radius: 10px;
    background:
      radial-gradient(circle at 88% 20%, rgba(6,201,219,.08), transparent 31%),
      radial-gradient(circle at 8% 90%, rgba(201,255,45,.07), transparent 34%),
      #03060c;
  }
  .sponsor-cta h2 {
    margin: 0;
    font-size: clamp(3.4rem, 7.8vw, 7.4rem);
    line-height: .88;
    letter-spacing: -.065em;
  }
  .sponsor-cta > p:not(.eyebrow) {
    max-width: 650px;
    margin: 26px 0 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  @media (max-width: 900px) {
    .hero { min-height: 760px; }
    .hero-image img { object-position: 60% center; }
    .hero-shade {
      background: linear-gradient(90deg, rgba(1,3,10,.97) 0%, rgba(1,3,10,.77) 70%, rgba(1,3,10,.42) 100%), linear-gradient(0deg,#01030a 0%,transparent 45%);
    }
    .support-inner { grid-template-columns: 1fr auto; padding-block: 22px; }
    .support-inner > p { grid-column: 1/-1; }
    .about-grid,
    .feature-heading,
    .robot-panel,
    .outreach-grid { grid-template-columns: 1fr; }
    .robot-panel-image { min-height: 480px; }
    .robot-panel-copy { border-left: 0; border-top: 1px solid var(--line); }
  }

  @media (max-width: 680px) {
    .hero h1 { font-size: clamp(3.5rem, 16vw, 6rem); }
    .hero-image img { object-position: 67% center; }
    .support-inner { grid-template-columns: 1fr; gap: 18px; }
    .support-logos { flex-wrap: wrap; gap: 20px; }
    .mini-link { justify-self: start; }
    .robot-stats { grid-template-columns: 1fr; }
    .robot-stats > div + div { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }
    .member-row { grid-template-columns: 38px 1fr 26px; gap: 14px; padding-block: 22px; }
    .member-row p { grid-column: 2/4; grid-row: 2; }
    .row-arrow { grid-column: 3; grid-row: 1; }
    .desktop-link { display: none; }
    .sponsor-cta-section { padding-bottom: 90px; }
  }
</style>
