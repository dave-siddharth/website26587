---
import Base from '../layouts/Base.astro';

const members = [
  ['Siddharth D', 'CAD / Programming / Portfolio / Driver'],
  ['Yuteng W', 'Finance / Build'],
  ['William R', 'Outreach / Build'],
];
---
<Base title="Triple Six — FIRST Tech Challenge Team 26587">
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="kicker">FIRST Tech Challenge · Team 26587 · Cambridge, UK</p>
        <h1 class="hero-title">Triple Six — engineering what comes next</h1>
        <p class="lede">A student-led community robotics team designing, building and programming competitive FTC robots while sharing what we learn beyond the field.</p>
        <div class="hero-links">
          <a class="primary-link" href="/sponsors">Support Triple Six</a>
          <a class="secondary-link" href="/team">Meet the team</a>
        </div>
      </div>
      <div class="hero-media">
        
      </div>
    </div>
  </section>

  <section class="support-bar">
    <div class="shell support-grid">
      <span>Supported by</span>
      <a href="/sponsors"><img src="/images/sponsors/dave-academy-transparent.png" alt="Dave Academy" /></a>
      <a href="/sponsors"><img src="/images/sponsors/cambridge-steam-lab-white.pngsteam-lab-transparent.png" alt="Cambridge STEAM Lab" /></a>
      <a class="support-link" href="/sponsors">Our sponsors →</a>
    </div>
  </section>

  <section class="section">
    <div class="shell section-heading">
      <div>
        <p class="kicker">About us</p>
        <h2>Who we are</h2>
      </div>
      <div>
        <p class="body-large">Triple Six is FTC Team 26587, a Cambridge-based team built around ambitious engineering, responsibility and iteration.</p>
        <p class="body-copy">Mechanical design, programming, build, portfolio, finance and outreach are owned by the students. Competition gives us a hard technical problem; the team gives us a way to solve it together.</p>
        <a class="text-link" href="/team">Read the full story</a>
      </div>
    </div>
  </section>

  <section class="section feature-section">
    <div class="shell feature-grid">
      <div class="feature-copy">
        <p class="kicker">Featured robot</p>
        <h2>DECODE</h2>
        <p class="body-large">A turreted scoring robot designed around range, repeatability and fast game-piece flow.</p>
        <div class="stats compact-stats">
          <div class="stat"><strong>240°</strong><span>turret travel</span></div>
          <div class="stat"><strong>5</strong><span>intake stages</span></div>
          <div class="stat"><strong>2</strong><span>scoring zones</span></div>
        </div>
        <a class="text-link" href="/robots/2025-2026">See the robot</a>
      </div>
      <div class="feature-media">
        <img src="/images/robots/decode.png" alt="DECODE robot CAD render" />
        <p>2025–2026 · DECODE</p>
      </div>
    </div>
  </section>

  <section class="section latest-section">
    <div class="shell section-heading">
      <div>
        <p class="kicker">Latest</p>
        <h2>What we have been doing</h2>
      </div>
      <div>
        <p class="body-large">Build progress, robot demonstrations, school talks, workshops and community robotics.</p>
        <a class="text-link" href="/outreach">See outreach</a>
      </div>
    </div>
    <div class="shell latest-images">
      <img src="/images/outreach/robot-demo.png" alt="Triple Six robot demonstration" />
      <img src="/images/outreach/scout-presentation.png" alt="Triple Six community presentation" />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="kicker">The team</p>
      <div class="team-heading-row">
        <h2 class="section-title">Who is on the team</h2>
        <a class="text-link" href="/team">Meet everyone</a>
      </div>
      <div class="rule-list member-rules">
        {members.map(([name, role], i) => (
          <a class="rule-row" href="/team">
            <span class="index">0{i + 1}</span>
            <div><h3>{name}</h3><p>{role}</p></div>
            <span class="arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section program-section">
    <div class="shell program-grid">
      <div>
        <p class="kicker">The program</p>
        <h2 class="section-title">What the FIRST Tech Challenge is</h2>
      </div>
      <div>
        <p class="body-large">FTC is a student robotics competition where teams design, build, program and drive a new robot around a different challenge each season.</p>
        <p class="body-copy">It combines mechanical engineering, software, strategy, communication and team operations — and gives students a reason to learn all of them at once.</p>
      </div>
    </div>
    <div class="shell program-photo">
      <img src="/images/outreach/hands-on-workshop.png" alt="Students taking part in hands-on robotics" />
    </div>
  </section>

  <section class="section sponsor-home">
    <div class="shell section-heading">
      <div>
        <p class="kicker">Support the team</p>
        <h2>Why sponsor Triple Six</h2>
      </div>
      <div>
        <p class="body-large">Sponsorship helps cover registrations, robot parts, tools and the work we share through outreach.</p>
        <div class="support-points">
          <div><h3>Robot development</h3><p>Parts, manufacturing, testing and iteration.</p></div>
          <div><h3>Competition access</h3><p>Registration and the costs of getting the team to events.</p></div>
          <div><h3>Community outreach</h3><p>Workshops, demonstrations and support for other students.</p></div>
        </div>
        <a class="text-link" href="/sponsors">See our sponsors</a>
        <a class="text-link second" href="/contact">Get in touch</a>
      </div>
    </div>
  </section>
</Base>

<style>
.home-hero { padding: clamp(74px, 10vw, 130px) 0; border-bottom: 1px solid var(--line); }
.hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(40px, 8vw, 110px); align-items: center; }
.hero-links { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 34px; }
.primary-link, .secondary-link { padding: 13px 18px; font-size: .78rem; font-weight: 760; letter-spacing: .05em; text-transform: uppercase; border: 1px solid var(--line); }
.primary-link { background: var(--text); color: #050607; border-color: var(--text); }
.primary-link:hover { background: var(--accent); border-color: var(--accent); }
.secondary-link:hover { border-color: var(--accent); }
.hero-media { overflow: hidden; background: #090a0c; aspect-ratio: 4/5; }
.hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.84) contrast(1.06); }
.support-bar { border-bottom: 1px solid var(--line); }
.support-grid { min-height: 112px; display: grid; grid-template-columns: auto 1fr 1.25fr auto; gap: 34px; align-items: center; }
.support-grid > span { color: var(--muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .12em; }
.support-grid img { max-height: 52px; width: 100%; max-width: 220px; object-fit: contain; object-position: left center; }
.support-link { font-size: .78rem; color: var(--muted); }
.feature-grid { display: grid; grid-template-columns: .78fr 1.22fr; gap: clamp(42px, 8vw, 108px); align-items: center; }
.feature-copy h2 { margin: 0 0 28px; font-size: clamp(3.4rem, 8vw, 8rem); line-height: .9; letter-spacing: -.07em; }
.feature-media { background: #07090b; }
.feature-media img { width: 100%; aspect-ratio: 16/10; object-fit: contain; }
.feature-media p { margin: 12px 0 0; color: var(--dim); font-size: .75rem; }
.compact-stats { margin-top: 32px; }
.latest-images { display: grid; grid-template-columns: 1.25fr .75fr; gap: 18px; margin-top: 58px; }
.latest-images img { width: 100%; height: 100%; max-height: 520px; object-fit: cover; }
.team-heading-row { display: flex; justify-content: space-between; gap: 30px; align-items: end; margin-bottom: 42px; }
.team-heading-row .text-link { margin: 0 0 4px; }
.program-grid { display: grid; grid-template-columns: .95fr 1.05fr; gap: clamp(40px, 8vw, 100px); }
.program-photo { margin-top: 62px; }
.program-photo img { width: 100%; max-height: 620px; object-fit: cover; }
.support-points { margin-top: 34px; border-top: 1px solid var(--line); }
.support-points > div { padding: 20px 0; border-bottom: 1px solid var(--line); }
.support-points h3 { margin: 0 0 5px; font-size: 1.08rem; }
.support-points p { margin: 0; color: var(--muted); }
.text-link.second { margin-left: 22px; }
@media (max-width: 820px) {
  .hero-grid, .feature-grid, .program-grid { grid-template-columns: 1fr; }
  .hero-media { aspect-ratio: 16/10; }
  .support-grid { grid-template-columns: 1fr 1fr; padding: 24px 0; }
  .support-grid > span, .support-link { grid-column: 1/-1; }
  .latest-images { grid-template-columns: 1fr; }
  .team-heading-row { display: block; }
  .team-heading-row .text-link { margin-top: 20px; }
}
</style>

<style>
.hero-media,
.hero-image,
.hero-photo,
.hero-visual,
.hero-art,
.hero-stage {
  display: none !important;
}
.hero {
  background: #000 !important;
}
</style>