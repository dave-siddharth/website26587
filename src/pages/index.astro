---
import Base from '../layouts/Base.astro';

const members = [
  ['Siddharth D', 'CAD / Programming / Portfolio / Driver'],
  ['Yuteng W', 'Finance / Build'],
  ['William R', 'Outreach / Build'],
];

const posts = [
  {
    url: 'https://www.instagram.com/p/DbTrv4stkl4/',
    image: '/images/outreach/robot-demo.png',
    label: 'Instagram post 01',
    date: '3 December 2025 · 22:03 UTC',
  },
  {
    url: 'https://www.instagram.com/p/DanZvcRn0nb/?img_index=1',
    image: '/images/outreach/scout-presentation.png',
    label: 'Instagram post 02',
    date: '16 November 2025 · 17:19 UTC',
  },
  {
    url: 'https://www.instagram.com/p/DXuw9zADVJ1/?img_index=1',
    image: '/images/outreach/school-presentation.png',
    label: 'Instagram post 03',
    date: '6 September 2025 · 00:22 UTC',
  },
];
---
<Base title="Triple Six — FIRST Tech Challenge Team 26587">

  <!-- Horizon-style opening -->
  <section class="home-hero">
    <div class="shell hero-shell">
      <div class="hero-topline">
        <p>FIRST Tech Challenge · Team 26587 · Cambridge, UK</p>
        <img src="/images/triple-six-logo.png" alt="" aria-hidden="true" />
      </div>

      <h1>
        <span class="team-word">Triple Six —</span>
        <span class="hero-message">Building towards<br />what’s next</span>
      </h1>

      <div class="hero-lower">
        <p class="hero-description">
          A student-led community robotics team in Cambridge, UK, designing,
          building and programming competitive FIRST Tech Challenge robots
          while sharing what we learn beyond the field.
        </p>

        <div class="hero-actions">
          <a class="hero-button primary" href="/sponsors">Sponsor Triple Six</a>
          <a class="hero-button" href="/team">Meet the team</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported-by strip directly under hero -->
  <section class="support-bar">
    <div class="shell support-grid">
      <p>Supported by</p>

      <a class="support-logo dave" href="/sponsors" aria-label="Dave Academy">
        <img src="/images/sponsors/dave-academy-original-clean.png" alt="Dave Academy" />
      </a>

      <a class="support-logo steam" href="/sponsors" aria-label="Cambridge STEAM Lab">
        <img src="/images/sponsors/cambridge-steam-lab-white.png" alt="Cambridge STEAM Lab" />
      </a>

      <a class="support-logo canva" href="/sponsors" aria-label="Canva">
        <img src="/images/sponsors/canva-logo.png" alt="Canva" />
      </a>

      <a class="support-link" href="/sponsors">Our sponsors <span>→</span></a>
    </div>
  </section>

  <!-- About us -->
  <section class="section">
    <div class="shell horizon-two-column">
      <div>
        <p class="kicker">About us</p>
        <h2>Who we are</h2>
      </div>

      <div class="section-copy">
        <p class="body-large">
          We are Triple Six (FTC 26587), a student-led robotics team based in
          Cambridge that takes on the engineering challenge of FIRST Tech
          Challenge one season at a time.
        </p>
        <p class="body-copy">
          Students own the CAD, programming, build, portfolio, finance and
          outreach. We prototype, test, fail, rebuild and document what we learn —
          then take that work onto the competition field and back into our community.
        </p>
        <a class="text-link" href="/team">Read the full story</a>
      </div>
    </div>
  </section>

  <!-- Horizon's large achievement/feature rhythm, adapted to Triple Six -->
  <section class="section achievement-section">
    <div class="shell achievement-grid">
      <div class="achievement-copy">
        <p class="kicker">Engineering</p>
        <h2>Built to adapt across the field</h2>
        <p class="body-large">
          DECODE combined a 240° turret, adjustable hood and five-stage intake
          into a robot designed for both close-zone and far-zone play.
        </p>

        <div class="achievement-stats">
          <div>
            <span class="stat-label">turret travel</span>
            <strong>240°</strong>
          </div>
          <div>
            <span class="stat-label">intake stages</span>
            <strong>5</strong>
          </div>
        </div>

        <a class="text-link" href="/robots/2025-2026">See the robot</a>
      </div>

      <figure class="achievement-media">
        <img src="/images/robots/decode.png" alt="DECODE robot CAD render" />
        <figcaption>DECODE · 2025–2026 season</figcaption>
      </figure>
    </div>
  </section>

  <!-- Team -->
  <section class="section">
    <div class="shell">
      <div class="team-title-row">
        <div>
          <p class="kicker">The team</p>
          <h2>Who is on the team</h2>
        </div>
        <a class="text-link no-margin" href="/team">Meet everyone</a>
      </div>

      <p class="team-intro">
        Three students lead Triple Six across engineering, programming,
        business, outreach and competition.
      </p>

      <div class="member-list">
        {members.map(([name, role], i) => (
          <a class="member-row" href="/team">
            <span class="member-index">0{i + 1}</span>
            <div>
              <h3>{name}</h3>
              <p>{role}</p>
            </div>
            <span class="member-arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Program -->
  <section class="section">
    <div class="shell horizon-two-column">
      <div>
        <p class="kicker">The program</p>
        <h2>What the FIRST Tech Challenge is</h2>
      </div>

      <div class="section-copy">
        <p class="body-large">
          FIRST Tech Challenge is a robotics competition for middle and high
          school students. Each season brings a new game and a new engineering
          problem to solve.
        </p>
        <p class="body-copy">
          Teams design, build, program and drive their own robots while learning
          mechanical engineering, software, strategy, communication and team operations.
        </p>
        <a
          class="text-link"
          href="https://www.firstinspires.org/robotics/ftc"
          target="_blank"
          rel="noreferrer"
        >firstinspires.org ↗</a>
      </div>
    </div>
  </section>

  <!-- Sponsor close -->
  <section class="section sponsor-close">
    <div class="shell horizon-two-column">
      <div>
        <p class="kicker">Support the team</p>
        <h2>Why sponsor Triple Six</h2>
      </div>

      <div class="section-copy">
        <p class="body-large">
          Sponsorship helps cover robot parts, registrations, tools and the
          outreach work that lets us share engineering with more students.
        </p>

        <div class="support-points">
          <div>
            <h3>Robot development</h3>
            <p>Parts, manufacturing, testing and iteration.</p>
          </div>
          <div>
            <h3>Competition access</h3>
            <p>Registration and the cost of getting the team to events.</p>
          </div>
          <div>
            <h3>Community outreach</h3>
            <p>Workshops, demonstrations and mentoring.</p>
          </div>
        </div>

        <div class="sponsor-callout">
          <span class="sponsor-callout-label">Your company could be here</span>
          <p>
            Put your organisation alongside the partners helping Triple Six build,
            compete and reach more students. Sponsors can be featured on our website,
            outreach materials and team communications.
          </p>
        </div>

        <div class="closing-links">
          <a class="hero-button primary" href="/sponsors">Sponsor Triple Six</a>
          <a class="hero-button" href="https://www.gofundme.com/f/support-ftc-team-26587-triple-six-for-their-upcoming-seaso" target="_blank" rel="noreferrer">Donate on GoFundMe</a>
          <a class="hero-button" href="/contact">Talk to us</a>
        </div>

        <a class="email-link" href="mailto:triplesixftc@gmail.com">triplesixftc@gmail.com</a>
      </div>
    </div>
  </section>
</Base>

<style>
/* Opening: deliberately very close in rhythm to Horizon's homepage,
   but with Triple Six content and branding. */
.home-hero {
  padding: clamp(74px, 9vw, 126px) 0 clamp(70px, 8vw, 112px);
  border-bottom: 1px solid var(--line);
  background: #020305;
}

.hero-shell {
  display: grid;
  gap: clamp(38px, 6vw, 72px);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.hero-topline p {
  margin: 0;
  color: var(--muted);
  font-size: .73rem;
  font-weight: 650;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.hero-topline img {
  width: 58px;
  height: 58px;
  object-fit: cover;
  border-radius: 50%;
}

.home-hero h1 {
  margin: 0;
  max-width: 1120px;
  font-weight: 690;
  line-height: .86;
  letter-spacing: -.075em;
}

.team-word {
  display: block;
  margin-bottom: 10px;
  color: var(--muted);
  font-size: clamp(1.65rem, 3.6vw, 3.9rem);
  line-height: 1;
  letter-spacing: -.05em;
  font-weight: 560;
}

.hero-message {
  display: block;
  color: var(--text);
  font-size: clamp(4rem, 10vw, 9.4rem);
}

.hero-lower {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(300px, 1.1fr);
  gap: clamp(34px, 9vw, 130px);
  align-items: end;
}

.hero-description {
  margin: 0;
  max-width: 650px;
  color: #c7cbd0;
  font-size: clamp(1.05rem, 1.8vw, 1.28rem);
  line-height: 1.68;
}

.hero-actions {
  display: flex;
  justify-content: flex-start;
  gap: 12px;
  flex-wrap: wrap;
}

.hero-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 18px;
  border: 1px solid var(--line);
  color: var(--text);
  font-size: .76rem;
  font-weight: 760;
  letter-spacing: .05em;
  text-transform: uppercase;
  transition: border-color .2s ease, background .2s ease, color .2s ease;
}

.hero-button:hover {
  border-color: var(--accent);
}

.hero-button.primary {
  background: var(--text);
  border-color: var(--text);
  color: #040506;
}

.hero-button.primary:hover {
  background: var(--accent);
  border-color: var(--accent);
}

/* Support strip */
.support-bar {
  border-bottom: 1px solid var(--line);
  background: #020305;
}

.support-grid {
  min-height: 112px;
  display: grid;
  grid-template-columns: auto auto auto auto 1fr;
  gap: 16px;
  align-items: center;
}

.support-grid > p {
  margin: 0;
  color: var(--muted);
  font-size: .7rem;
  font-weight: 650;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.support-logo {
  display: flex;
  align-items: center;
  min-height: 68px;
}

.support-logo img {
  width: 100%;
  object-fit: contain;
  object-position: left center;
}

.support-logo.dave img {
  max-width: 140px;
  max-height: 46px;
}

.support-logo.steam img {
  max-width: 188px;
  max-height: 46px;
}

.support-logo.canva img {
  max-width: 132px;
  max-height: 44px;
}

.support-link {
  margin-left: auto;
  color: var(--muted);
  font-size: .78rem;
  white-space: nowrap;
}

.support-link span {
  color: var(--accent);
}

/* Core Horizon-like two-column section rhythm */
.horizon-two-column {
  display: grid;
  grid-template-columns: .82fr 1.18fr;
  gap: clamp(44px, 9vw, 124px);
  align-items: start;
}

.horizon-two-column h2,
.team-title-row h2 {
  margin: 0;
  font-size: clamp(2.8rem, 5.9vw, 5.9rem);
  line-height: .93;
  letter-spacing: -.06em;
  font-weight: 675;
}

.section-copy {
  max-width: 720px;
}

/* Feature / achievement */
.achievement-grid {
  display: grid;
  grid-template-columns: .78fr 1.22fr;
  gap: clamp(44px, 8vw, 110px);
  align-items: center;
}

.achievement-copy h2 {
  margin: 0 0 28px;
  max-width: 620px;
  font-size: clamp(3rem, 6.5vw, 6.7rem);
  line-height: .9;
  letter-spacing: -.065em;
  font-weight: 680;
}

.achievement-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin-top: 36px;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.achievement-stats > div {
  padding: 24px 0;
}

.achievement-stats > div + div {
  border-left: 1px solid var(--line);
  padding-left: 28px;
}

.stat-label {
  display: block;
  margin-bottom: 4px;
  color: var(--muted);
  font-size: .7rem;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.achievement-stats strong {
  display: block;
  font-size: clamp(2.4rem, 5vw, 4.5rem);
  line-height: 1;
  letter-spacing: -.06em;
}

.achievement-media {
  margin: 0;
}

.achievement-media img {
  width: 100%;
  aspect-ratio: 16 / 10;
  object-fit: contain;
  background: #07090b;
}

.achievement-media figcaption {
  margin-top: 11px;
  color: var(--dim);
  font-size: .72rem;
}

/* Team */
.team-title-row {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 32px;
}

.text-link.no-margin {
  margin: 0 0 7px;
}

.team-intro {
  max-width: 660px;
  margin: 24px 0 48px;
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.75;
}

.member-list {
  border-top: 1px solid var(--line);
}

.member-row {
  display: grid;
  grid-template-columns: 72px 1fr auto;
  gap: 22px;
  align-items: center;
  min-height: 110px;
  border-bottom: 1px solid var(--line);
}

.member-index {
  color: var(--dim);
  font-size: .7rem;
  letter-spacing: .12em;
}

.member-row h3 {
  margin: 0;
  font-size: clamp(1.55rem, 3vw, 2.55rem);
  letter-spacing: -.04em;
  font-weight: 620;
}

.member-row p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: .9rem;
}

.member-arrow {
  color: var(--accent);
}

/* Sponsor close */
.support-points {
  margin-top: 34px;
  border-top: 1px solid var(--line);
}

.support-points > div {
  padding: 20px 0;
  border-bottom: 1px solid var(--line);
}

.support-points h3 {
  margin: 0 0 4px;
  font-size: 1rem;
}

.support-points p {
  margin: 0;
  color: var(--muted);
  font-size: .92rem;
}

.sponsor-callout {
  margin-top: 32px;
  padding: 24px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.sponsor-callout-label {
  display: block;
  margin-bottom: 8px;
  color: var(--accent);
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.sponsor-callout p {
  margin: 0;
  max-width: 58ch;
  color: var(--muted);
  line-height: 1.7;
}

.closing-links {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.email-link {
  display: inline-block;
  margin-top: 28px;
  color: var(--muted);
  font-size: .86rem;
  border-bottom: 1px solid var(--line);
  padding-bottom: 3px;
}

@media (max-width: 860px) {
  .hero-topline img {
    width: 48px;
    height: 48px;
  }

  .hero-lower,
  .horizon-two-column,
  .achievement-grid {
    grid-template-columns: 1fr;
  }

  .hero-lower {
    gap: 28px;
  }

  .support-grid {
  min-height: 112px;
  display: grid;
  grid-template-columns: auto auto auto auto 1fr;
  gap: 16px;
  align-items: center;
}

  .support-grid > p,
  .support-link {
    grid-column: 1 / -1;
  }

  .team-title-row {
    align-items: start;
    flex-direction: column;
  }

  .member-row {
    grid-template-columns: 48px 1fr auto;
  }
}

@media (max-width: 520px) {
  .hero-message {
    font-size: clamp(3.25rem, 17vw, 5.3rem);
  }

  .hero-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-button {
    width: 100%;
  }

  .support-grid {
  min-height: 112px;
  display: grid;
  grid-template-columns: auto auto auto auto 1fr;
  gap: 16px;
  align-items: center;
}

  .support-grid > p,
  .support-link {
    grid-column: auto;
  }

  .support-logo img {
    max-width: 210px;
  }

  .achievement-stats {
    grid-template-columns: 1fr;
  }

  .achievement-stats > div + div {
    border-left: 0;
    border-top: 1px solid var(--line);
    padding-left: 0;
  }

  .post-meta {
    flex-direction: column;
  }
}
</style>
