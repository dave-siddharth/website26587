---
import Base from '../../layouts/Base.astro';

const features = [
  'REV Parallel Plate Mecanum Drivetrain',
  '240° Turret',
  'Adjustable Hood',
  'Far-zone and close-zone compatibility',
  '5-stage intake with vectorising wheels',
];

const systems = [
  ['01','Drivetrain','REV Parallel Plate mecanum drivetrain designed for fast, stable movement and controlled handling.'],
  ['02','Turret','A 240° turreted scoring architecture for flexible aiming and efficient field coverage.'],
  ['03','Scoring','Adjustable hood system for controlled scoring across multiple distances and shot profiles.'],
  ['04','Intake','5-stage intake with vectorising wheels for reliable collection and game-piece control.'],
  ['05','Software','Control systems, driver operation and tuning for repeatable performance.'],
];
---
<Base title="2025–2026 · DECODE · Triple Six">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">2025–2026 season</p>
      <h1>DE<span class="gradient-text">CODE.</span></h1>
      <p class="lede">A turreted scoring robot built for adaptability, speed and compatibility across close-zone and far-zone play.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="robot-hero">
        <img src="/images/robots/decode.png" alt="DECODE robot CAD render" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <p class="eyebrow">Key features</p>
        <h2 class="section-title">What defined DECODE.</h2>
      </div>
      <div>
        <ul class="feature-list">
          {features.map((feature) => <li>{feature}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Subsystems</p>
      <div class="small-grid">
        {systems.map(([n, title, desc]) => (
          <article class="small-card">
            <span class="number">{n}</span>
            <h3>{title}</h3>
            <p>{desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
.robot-hero {
  min-height: 620px;
  border-radius: 28px;
  background: #05070d;
  overflow: hidden;
  display: grid;
  place-items: center;
  padding: 30px;
}

.robot-hero img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.feature-list {
  margin: 0;
  padding-left: 1.2rem;
  color: var(--text);
  font-size: clamp(1rem, 2vw, 1.15rem);
}

.feature-list li {
  margin: 0 0 16px;
  color: var(--muted);
}

.feature-list li::marker {
  color: var(--lime);
}
</style>
