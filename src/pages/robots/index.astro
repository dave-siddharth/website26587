---
import Base from '../../layouts/Base.astro';
import RobotSeasonNav from '../../components/RobotSeasonNav.astro';

const robots = [
  {
    season: '2026–27',
    name: 'BIOBUZZ',
    status: 'PRESEASON',
    description: 'Pocketed goBILDA drivetrain concept for preseason development and testing.',
    href: '/robots/2026-2027',
    image: '/images/robots/biobuzz-preseason.png',
    cta: 'Follow the build',
  },
  {
    season: '2025–26',
    name: 'DECODE',
    status: 'COMPLETED',
    description: 'Turreted scoring robot built for far-zone and close-zone compatibility.',
    href: '/robots/2025-2026',
    image: '/images/robots/decode.png',
    cta: 'Explore the robot',
  },
  {
    season: '2024–25',
    name: 'INTO THE DEEP',
    status: 'COMPLETED',
    description: 'Starter-bot-based robot with mecanum upgrade, 3D printed side triangles and an efficient claw system.',
    href: '/robots/2024-2025',
    image: '/images/robots/into-the-deep.png',
    cta: 'View season',
  },
];
---
<Base title="Robots · Triple Six FTC 26587">
  <RobotSeasonNav current="SEASONS / ROBOTS" />
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Engineering archive</p>
      <h1>OUR <span class="gradient-text">ROBOTS.</span></h1>
      <p class="lede">Three seasons of design, iteration and competition.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell robot-stack">
      {robots.map((robot) => (
        <a class="robot-panel" href={robot.href}>
          <div class="robot-image-wrap">
            <div class="robot-image">
              <img src={robot.image} alt={`${robot.name} robot`} loading="lazy" />
            </div>
          </div>

          <div class="robot-copy">
            <div class="robot-meta">
              <span>{robot.name}</span>
              <span>·</span>
              <span>{robot.season}</span>
              <span class="status-pill">{robot.status}</span>
            </div>
            <h2>{robot.name === 'INTO THE DEEP' ? 'Our first\ncompetition robot' : robot.name === 'DECODE' ? 'Our second\ncompetition robot' : 'Our current\nrobot platform'}</h2>
            <p>{robot.description}</p>
            <span class="robot-link">{robot.cta} <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
.robot-stack {
  display: grid;
  gap: 42px;
}

.robot-panel {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(360px, .85fr);
  gap: clamp(34px, 6vw, 70px);
  align-items: center;
  padding: 46px;
  border: 1px solid rgba(112,230,129,.18);
  border-radius: 28px;
  background:
    radial-gradient(circle at 12% 20%, rgba(202,255,50,.035), transparent 32%),
    radial-gradient(circle at 90% 85%, rgba(17,207,224,.03), transparent 34%),
    var(--panel-bg);
  box-shadow: 0 14px 40px rgba(0,0,0,.18);
}

.robot-image-wrap {
  min-width: 0;
}

.robot-image {
  min-height: 430px;
  border: 1px dashed rgba(17,207,224,.20);
  border-radius: 24px;
  display: grid;
  place-items: center;
  padding: 26px;
  background: var(--panel-bg);
}

.robot-image img {
  width: 100%;
  height: 100%;
  max-height: 360px;
  object-fit: contain;
  display: block;
}

.robot-copy {
  min-width: 0;
}

.robot-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  color: var(--muted);
  font-size: .88rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  margin-bottom: 26px;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 9px 18px;
  border: 1px solid var(--line-strong);
  border-radius: 999px;
  letter-spacing: .16em;
}

.robot-copy h2 {
  margin: 0 0 18px;
  font-size: clamp(3rem, 6vw, 5.5rem);
  line-height: .92;
  letter-spacing: -.06em;
  white-space: pre-line;
  font-weight: 420;
}

.robot-copy p {
  margin: 0 0 28px;
  color: var(--muted);
  font-size: clamp(1rem, 2vw, 1.14rem);
  line-height: 1.7;
  max-width: 28ch;
}

.robot-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--cyan);
  font-weight: 700;
  font-size: 1rem;
}

.robot-panel {
  transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
}

.robot-panel:hover {
  transform: translateY(-4px);
  border-color: rgba(202,255,50,.34);
  box-shadow: 0 18px 58px rgba(17,207,224,.08);
}

.status-pill {
  background: linear-gradient(90deg, rgba(202,255,50,.055), rgba(17,207,224,.045));
}

@media (max-width: 920px) {
  .robot-panel {
    grid-template-columns: 1fr;
    padding: 24px;
    gap: 24px;
  }

  .robot-image {
    min-height: 280px;
  }

  .robot-copy h2 {
    font-size: clamp(2.4rem, 9vw, 4rem);
  }
}
</style>
