---
import Base from '../../layouts/Base.astro';

const robots = [
  {
    season: '2024–2025',
    name: 'INTO THE DEEP',
    status: 'Completed',
    description: 'A starter-bot-based robot with mecanum upgrade, 3D printed side triangles and an efficient claw system.',
    href: '/robots/2024-2025',
    image: '/images/robots/into-the-deep.png',
  },
  {
    season: '2025–2026',
    name: 'DECODE',
    status: 'Completed',
    description: 'Turreted scoring robot built for far-zone and close-zone compatibility.',
    href: '/robots/2025-2026',
    image: '/images/robots/decode.png',
  },
  {
    season: '2026–2027',
    name: 'BIOBUZZ',
    status: 'Preseason',
    description: 'Pocketed goBILDA drivetrain concept for preseason development and testing.',
    href: '/robots/2026-2027',
    image: '/images/robots/biobuzz-preseason.png',
  },
];
---
<Base title="Robots · Triple Six FTC 26587">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Engineering archive</p>
      <h1>OUR <span class="gradient-text">ROBOTS.</span></h1>
      <p class="lede">A living record of the machines we design, prototype, test and compete with.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell robot-list">
      {robots.map((robot) => (
        <a class="robot-entry" href={robot.href}>
          <div class="robot-image">
            {robot.image ? (
              <img src={robot.image} alt={`${robot.name} robot`} loading="lazy" />
            ) : (
              <div class="robot-placeholder">Robot image to add</div>
            )}
          </div>

          <div class="robot-info">
            <div class="meta">
              <span>{robot.season}</span>
              <span>{robot.status}</span>
            </div>
            <h2>{robot.name}</h2>
            <p>{robot.description}</p>
            <span class="link">Open season page</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
.robot-list {
  display: grid;
  gap: 88px;
}

.robot-entry {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr);
  gap: clamp(32px, 6vw, 88px);
  align-items: end;
}

.robot-entry:nth-child(even) .robot-image {
  order: 2;
}

.robot-entry:nth-child(even) .robot-info {
  order: 1;
}

.robot-image {
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: 4px;
  background: #05070d;
}

.robot-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.robot-placeholder {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  border: 1px dashed rgba(255,255,255,.15);
  color: rgba(255,255,255,.25);
  font-size: .75rem;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.robot-info h2 {
  margin: 12px 0 10px;
  font-size: clamp(3rem, 7vw, 6.5rem);
  line-height: .9;
  letter-spacing: -.06em;
}

.robot-info p {
  margin: 0 0 22px;
  color: var(--muted);
  max-width: 40ch;
}

@media (max-width: 760px) {
  .robot-entry {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .robot-entry:nth-child(even) .robot-image,
  .robot-entry:nth-child(even) .robot-info {
    order: initial;
  }
}
</style>
