---
import Base from '../../layouts/Base.astro';
const robots = [
  { season:'2026–2027', name:'BIOBUZZ', status:'Preseason', description:'Pocketed goBILDA drivetrain concept for preseason testing and development.', href:'/robots/2026-2027', image:'/images/robots/biobuzz-preseason.png' },
  { season:'2025–2026', name:'DECODE', status:'Complete', description:'Turreted scoring robot with adjustable hood, five-stage intake and far-zone / close-zone compatibility.', href:'/robots/2025-2026', image:'/images/robots/decode.png' },
  { season:'2024–2025', name:'INTO THE DEEP', status:'Complete', description:'REV Starter Bot architecture with mecanum upgrade, 3D printed side structures and efficient claw system.', href:'/robots/2024-2025', image:'/images/robots/into-the-deep.png' },
];
---
<Base title="Robots — Triple Six FTC 26587">
  <section class="page-hero">
    <div class="shell">
      <p class="kicker">Robots</p>
      <h1>Our robots</h1>
      <p class="lede">Three seasons of FTC engineering — from our first competition platform through DECODE and into BIOBUZZ preseason development.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell robot-list">
      {robots.map((robot) => (
        <a class="robot-card" href={robot.href}>
          <div class="robot-media"><img src={robot.image} alt={`${robot.name} robot`} loading="lazy" /></div>
          <div class="robot-copy">
            <div class="meta-row"><span>{robot.name} · {robot.season}</span><span>{robot.status}</span></div>
            <h2>{robot.name}</h2>
            <p>{robot.description}</p>
            <span class="text-link">See the robot</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
.robot-list { display:grid; gap:0; }
.robot-card { display:grid; grid-template-columns:1.2fr .8fr; gap:clamp(36px,7vw,92px); padding:52px 0; border-top:1px solid var(--line); align-items:center; }
.robot-card:last-child { border-bottom:1px solid var(--line); }
.robot-media { background:#080a0c; overflow:hidden; }
.robot-media img { width:100%; aspect-ratio:16/10; object-fit:contain; }
.robot-copy h2 { margin:18px 0 12px; font-size:clamp(2.8rem,6vw,5.6rem); line-height:.9; letter-spacing:-.06em; }
.robot-copy p { margin:0; color:var(--muted); max-width:46ch; line-height:1.75; }
@media(max-width:800px){.robot-card{grid-template-columns:1fr;gap:26px}}
</style>