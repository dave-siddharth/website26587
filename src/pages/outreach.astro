---
import Base from '../layouts/Base.astro';
const items = [
  ['Community presentations','We introduce students and local groups to FTC, robotics and the engineering process behind our team.','/images/outreach/scout-presentation.png'],
  ['School engagement','Talks and demonstrations show how an FTC team works and how students can get involved.','/images/outreach/school-presentation.png'],
  ['Hands-on workshops','Students explore robots, game fields and practical engineering through building and testing.','/images/outreach/hands-on-workshop.png'],
  ['Remote support','Online sessions let us share progress, troubleshoot and support robotics learning beyond in-person events.','/images/outreach/remote-session.png'],
  ['Robot demonstrations','We put real machines in front of students so design decisions become tangible.','/images/outreach/robot-demo.png'],
];
---
<Base title="Outreach — Triple Six FTC 26587">
  <section class="page-hero"><div class="shell"><p class="kicker">Outreach</p><h1>What we share</h1><p class="lede">Competition is only part of the work. We use presentations, workshops, demonstrations and online support to make robotics more accessible.</p></div></section>
  <section class="section"><div class="shell outreach-list">{items.map(([title,desc,image],i)=><article class="outreach-row"><img src={image} alt={title} loading="lazy"/><div><span class="index">0{i+1}</span><h2>{title}</h2><p>{desc}</p></div></article>)}</div></section>
</Base>
<style>
.outreach-list{border-top:1px solid var(--line)}.outreach-row{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(34px,7vw,88px);align-items:center;padding:48px 0;border-bottom:1px solid var(--line)}.outreach-row:nth-child(even) img{order:2}.outreach-row img{width:100%;max-height:480px;object-fit:cover}.outreach-row .index{color:var(--dim);font-size:.72rem;letter-spacing:.1em}.outreach-row h2{margin:12px 0 12px;font-size:clamp(2.3rem,5vw,4.6rem);line-height:.95;letter-spacing:-.055em}.outreach-row p{margin:0;color:var(--muted);line-height:1.75}@media(max-width:800px){.outreach-row{grid-template-columns:1fr}.outreach-row:nth-child(even) img{order:initial}}
</style>