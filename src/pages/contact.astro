---
import Base from '../layouts/Base.astro';
---
<Base title="Contact · Triple Six FTC 26587">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h1>GET IN <span class="gradient-text">TOUCH.</span></h1>
      <p class="lede">For sponsorship, collaboration, outreach or team enquiries.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell contact-list">
      <a class="contact-row" href="mailto:triplesixftc@gmail.com">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M4 7l8 6 8-6"></path>
          </svg>
        </span>
        <span class="label">Email</span>
        <span class="value">triplesixftc@gmail.com</span>
        <span class="arrow">↗</span>
      </a>

      <a class="contact-row" href="https://www.instagram.com/triplesixftc/" target="_blank" rel="noreferrer">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"></rect>
            <circle cx="12" cy="12" r="4.2"></circle>
            <circle cx="17.4" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle>
          </svg>
        </span>
        <span class="label">Instagram</span>
        <span class="value">@triplesixftc</span>
        <span class="arrow">↗</span>
      </a>

      <a class="contact-row" href="https://www.youtube.com/@TripleSixFTC" target="_blank" rel="noreferrer">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12s0-3.2-.4-4.8a2.9 2.9 0 0 0-2-2C18 4.7 12 4.7 12 4.7s-6 0-7.6.5a2.9 2.9 0 0 0-2 2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.9 2.9 0 0 0 2 2c1.6.5 7.6.5 7.6.5s6 0 7.6-.5a2.9 2.9 0 0 0 2-2C22 15.2 22 12 22 12Z"></path>
            <path d="M10 8.8l5.2 3.2L10 15.2V8.8Z" fill="currentColor" stroke="none"></path>
          </svg>
        </span>
        <span class="label">YouTube</span>
        <span class="value">@TripleSixFTC</span>
        <span class="arrow">↗</span>
      </a>
    </div>
  </section>
</Base>

<style>
.contact-list {
  border-top: 1px solid var(--line);
}

.contact-row {
  display: grid;
  grid-template-columns: 58px 150px 1fr auto;
  gap: 24px;
  align-items: center;
  padding: 28px 0;
  border-bottom: 1px solid var(--line);
  transition: opacity .2s ease;
}

.contact-row:hover {
  opacity: 1;
  background: linear-gradient(90deg, rgba(202,255,50,.025), rgba(17,207,224,.02));
}

.icon {
  width: 44px;
  height: 44px;
  border: 1px solid rgba(112,230,129,.20);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--lime);
  background: rgba(255,255,255,.02);
}

.icon svg {
  width: 21px;
  height: 21px;
}

.label {
  color: var(--muted);
  font-size: .75rem;
  text-transform: uppercase;
  letter-spacing: .16em;
}

.value {
  font-size: clamp(1.15rem, 3vw, 2.35rem);
  letter-spacing: -.03em;
  overflow-wrap: anywhere;
}

.arrow {
  color: var(--lime);
  font-size: 1.2rem;
}

@media (max-width: 760px) {
  .contact-row {
    grid-template-columns: 58px 1fr auto;
    gap: 16px;
  }

  .label {
    grid-column: 2 / -1;
    margin-top: -4px;
  }

  .value {
    grid-column: 2 / 3;
    font-size: 1.2rem;
  }

  .arrow {
    grid-column: 3 / 4;
    grid-row: 1 / span 2;
    align-self: center;
  }
}
</style>
