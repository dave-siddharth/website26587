---
import Base from '../layouts/Base.astro';
import SponsorStrip from '../components/SponsorStrip.astro';

const pageTitle = 'Contact · Triple Six FTC 26587';
const pageDescription = 'Contact FTC Team 26587 Triple Six for sponsorship, outreach, collaboration, and general enquiries.';
---

<Base title={pageTitle} description={pageDescription}>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">CONTACT</p>
      <h1>Send us a message</h1>
      <p class="lede">
        Goes straight to the team inbox. Nothing is stored on this site.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="shell">
      <div class="contact-card">
        <form class="contact-form" action="mailto:triplesixftc@gmail.com" method="post" enctype="text/plain">
          <div class="form-grid two">
            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="name" type="text" required />
            </div>

            <div class="field">
              <label for="company">Company or school <span>optional</span></label>
              <input id="company" name="company" type="text" />
            </div>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required />
          </div>

          <div class="field">
            <label for="topic">What is this about?</label>
            <select id="topic" name="topic">
              <option>Sponsoring Triple Six</option>
              <option>Outreach or workshop</option>
              <option>Collaboration</option>
              <option>Mentoring</option>
              <option>General enquiry</option>
            </select>
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="8"></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="send-button">
              <span>Send message</span>
              <span aria-hidden="true">→</span>
            </button>

            <p class="alt-contact">
              Or write to
              <a href="mailto:triplesixftc@gmail.com">triplesixftc@gmail.com</a>
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>


  <section class="direct-contact">
    <div class="shell">
      <div class="direct-contact-grid">
        <a class="contact-link-card" href="mailto:triplesixftc@gmail.com" aria-label="Email Triple Six FTC">
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="3" y="5.5" width="18" height="13" rx="2.2" stroke="currentColor" stroke-width="1.8"/>
              <path d="M4.5 7.5 12 13.2 19.5 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="contact-meta">
            <strong>Email</strong>
            <span>triplesixftc@gmail.com</span>
          </span>
        </a>

        <a class="contact-link-card" href="https://www.instagram.com/triplesixftc/" target="_blank" rel="noreferrer" aria-label="Instagram Triple Six FTC">
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/>
            </svg>
          </span>
          <span class="contact-meta">
            <strong>Instagram</strong>
            <span>@triplesixftc</span>
          </span>
        </a>

        <a class="contact-link-card" href="https://www.youtube.com/@TripleSixFTC" target="_blank" rel="noreferrer" aria-label="YouTube Triple Six FTC">
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M21 8.6c0-1.6-1.2-2.8-2.8-3-2-.2-4.1-.3-6.2-.3s-4.2.1-6.2.3C4.2 5.8 3 7 3 8.6v6.8c0 1.6 1.2 2.8 2.8 3 2 .2 4.1.3 6.2.3s4.2-.1 6.2-.3c1.6-.2 2.8-1.4 2.8-3V8.6Z" stroke="currentColor" stroke-width="1.8"/>
              <path d="M10.2 9.3 15.2 12l-5 2.7V9.3Z" fill="currentColor"/>
            </svg>
          </span>
          <span class="contact-meta">
            <strong>YouTube</strong>
            <span>@TripleSixFTC</span>
          </span>
        </a>
      </div>
    </div>
  </section>


  <SponsorStrip />
</Base>

<style>
.page-hero {
  padding: 88px 0 20px;
}

.eyebrow {
  margin: 0 0 12px;
  font-size: .76rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--green);
  font-weight: 700;
}

.page-hero h1 {
  margin: 0;
  font-size: clamp(2.4rem, 5vw, 4rem);
  line-height: .98;
  letter-spacing: -.035em;
}

.lede {
  max-width: 720px;
  margin: 18px 0 0;
  color: var(--muted);
  font-size: 1.1rem;
  line-height: 1.75;
}

.contact-section {
  padding: 18px 0 96px;
}

.contact-card {
  border: 1px solid var(--line);
  border-radius: 34px;
  background:
    radial-gradient(circle at 10% 0%, rgba(202,255,50,.035), transparent 22%),
    radial-gradient(circle at 100% 0%, rgba(17,207,224,.05), transparent 22%),
    var(--panel-bg);
  box-shadow: var(--accent-glow);
  padding: clamp(26px, 4vw, 42px);
}

.contact-form {
  display: grid;
  gap: 26px;
}

.form-grid.two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}

.field {
  display: grid;
  gap: 12px;
}

.field label {
  display: flex;
  align-items: baseline;
  gap: 10px;
  font-size: 1.02rem;
  font-weight: 600;
  color: var(--text);
}

.field label span {
  color: var(--muted);
  font-size: .94rem;
  font-weight: 500;
}

.field input,
.field select,
.field textarea {
  width: 100%;
  border-radius: 22px;
  border: 1px solid var(--line);
  background: color-mix(in srgb, var(--surface-1) 78%, transparent);
  color: var(--text);
  padding: 18px 20px;
  font: inherit;
  outline: none;
  transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
}

.field input,
.field select {
  min-height: 64px;
}

.field textarea {
  min-height: 240px;
  resize: vertical;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
  border-color: rgba(112,230,129,.55);
  box-shadow: 0 0 0 4px rgba(17,207,224,.08);
}

.field select {
  appearance: none;
  background-image:
    linear-gradient(45deg, transparent 50%, var(--muted) 50%),
    linear-gradient(135deg, var(--muted) 50%, transparent 50%);
  background-position:
    calc(100% - 28px) calc(50% - 3px),
    calc(100% - 20px) calc(50% - 3px);
  background-size: 8px 8px, 8px 8px;
  background-repeat: no-repeat;
  padding-right: 52px;
}

.form-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
  align-items: center;
  margin-top: 8px;
}

.send-button {
  border: none;
  border-radius: 999px;
  padding: 19px 34px;
  min-width: 250px;
  background: linear-gradient(135deg, #ff8c52 0%, #ff6b3d 100%);
  color: #140804;
  font: inherit;
  font-weight: 800;
  font-size: 1.2rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  cursor: pointer;
  box-shadow: 0 14px 36px rgba(255,107,61,.2);
  transition: transform .18s ease, box-shadow .18s ease;
}

.send-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 18px 40px rgba(255,107,61,.26);
}

.alt-contact {
  margin: 0;
  color: var(--muted);
  font-size: 1.05rem;
}

.alt-contact a {
  color: #ffd35a;
  text-decoration: underline;
  text-underline-offset: 3px;
}

:root[data-theme="light"] .contact-card {
  background:
    radial-gradient(circle at 10% 0%, rgba(202,255,50,.08), transparent 24%),
    radial-gradient(circle at 100% 0%, rgba(17,207,224,.08), transparent 24%),
    rgba(255,255,255,.74);
  backdrop-filter: blur(5px);
}

:root[data-theme="light"] .field input,
:root[data-theme="light"] .field select,
:root[data-theme="light"] .field textarea {
  background: rgba(255,255,255,.82);
}

@media (max-width: 860px) {
  .form-grid.two {
    grid-template-columns: 1fr;
  }

  .form-actions {
    align-items: flex-start;
    flex-direction: column;
  }

  .send-button {
    min-width: 0;
    width: 100%;
  }
}

.direct-contact {
  padding: 0 0 72px;
}

.direct-contact-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.contact-link-card {
  display: flex;
  align-items: center;
  gap: 16px;
  border: 1px solid var(--line);
  border-radius: 24px;
  background:
    radial-gradient(circle at 0% 0%, rgba(202,255,50,.04), transparent 32%),
    radial-gradient(circle at 100% 0%, rgba(17,207,224,.05), transparent 32%),
    var(--panel-bg);
  padding: 18px;
  text-decoration: none;
  color: var(--text);
  transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
}

.contact-link-card:hover {
  transform: translateY(-2px);
  border-color: rgba(112,230,129,.42);
  box-shadow: 0 14px 30px rgba(0,0,0,.16);
}

.contact-icon {
  width: 52px;
  height: 52px;
  flex: 0 0 52px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(202,255,50,.13), rgba(17,207,224,.16));
  color: var(--text);
}

.contact-icon svg {
  width: 24px;
  height: 24px;
}

.contact-meta {
  display: grid;
  gap: 4px;
}

.contact-meta strong {
  font-size: 1rem;
  line-height: 1.15;
}

.contact-meta span:last-child {
  color: var(--muted);
  font-size: .98rem;
}

:root[data-theme="light"] .contact-link-card {
  background:
    radial-gradient(circle at 0% 0%, rgba(202,255,50,.08), transparent 34%),
    radial-gradient(circle at 100% 0%, rgba(17,207,224,.08), transparent 34%),
    rgba(255,255,255,.72);
}

@media (max-width: 960px) {
  .direct-contact-grid {
    grid-template-columns: 1fr;
  }
}

</style>
