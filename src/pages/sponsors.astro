---
import Base from '../layouts/Base.astro';

const sponsors = [
  {
    name: 'Dave Academy',
    logo: '/images/sponsors/dave-academy-clean.png',
    support: 'Registration Support · Mentorship',
    description: 'Dave Academy helped fund our FTC registration costs and supports Triple Six through mentors from their organisation.',
  },
  {
    name: 'Cambridge STEAM Lab',
    logo: '/images/sponsors/cambridge-steam-lab-white.png',
    support: 'Parent Organisation · Mentorship · Financial Support',
    description: 'Cambridge STEAM Lab is our parent organisation. They provide mentors to the team and have supported Triple Six financially.',
  },
  {
    name: 'Canva',
    logo: '/images/sponsors/canva-wordmark.svg',
    support: 'Design Support',
    description: 'Canva supports Triple Six by helping us create visual materials for outreach, communication and team presentation.',
  },
];
---
<Base title="Sponsors · Triple Six FTC 26587">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Partners</p>
      <h1>OUR <span class="gradient-text">SPONSORS.</span></h1>
      <p class="lede">The organisations that help make our engineering, competition and outreach possible.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell sponsor-list">
      {sponsors.map((sponsor, index) => (
        <article class="sponsor">
          <div class="sponsor-logo-wrap">
            <img src={sponsor.logo} alt={`${sponsor.name} logo`} loading="lazy" />
          </div>
          <div class="sponsor-copy">
            <span class="sponsor-number">{String(index + 1).padStart(2, '0')}</span>
            <p class="support">{sponsor.support}</p>
            <h2>{sponsor.name}</h2>
            <p class="description">{sponsor.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="shell your-company-block">
      <p class="eyebrow">Partner with Triple Six</p>
      <h2>Your company could be on this page.</h2>
      <p>
        Support FTC Team 26587 and your organisation can be recognised alongside
        the partners helping us engineer better robots, compete, and expand our
        outreach. We can feature sponsors on our website, team materials and
        selected outreach communications.
      </p>
      <div class="partner-actions">
        <a class="partner-button primary" href="/contact">Become a sponsor</a>
        <a class="partner-button" href="mailto:triplesixftc@gmail.com">Email us</a>
      </div>
    </div>
  </section>

</Base>

<style>
.sponsor-list {
  display: grid;
  gap: 34px;
}

.sponsor {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(320px, .95fr);
  gap: clamp(36px, 6vw, 88px);
  align-items: center;
  padding-bottom: 72px;
  border-bottom: 1px solid var(--line);
}

.sponsor:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.sponsor:nth-child(even) .sponsor-logo-wrap {
  order: 2;
}

.sponsor:nth-child(even) .sponsor-copy {
  order: 1;
}

.sponsor-logo-wrap {
  min-height: 190px;
  display: grid;
  place-items: center;
  padding: 10px 0;
  background: transparent;
}

.sponsor-logo-wrap img {
  width: min(100%, 620px);
  max-height: 140px;
  object-fit: contain;
}

.sponsor-number {
  color: var(--lime);
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .2em;
}

.support {
  margin: 18px 0 10px;
  color: var(--lime);
  font-size: .76rem;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.sponsor h2 {
  margin: 0 0 18px;
  font-size: clamp(3rem, 6vw, 5.5rem);
  line-height: .92;
  letter-spacing: -.06em;
}

.description {
  max-width: 48ch;
  margin: 0;
  color: var(--muted);
  font-size: clamp(1rem, 2vw, 1.12rem);
  line-height: 1.7;
}

@media (max-width: 800px) {
  .sponsor {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .sponsor:nth-child(even) .sponsor-logo-wrap,
  .sponsor:nth-child(even) .sponsor-copy {
    order: initial;
  }

  .sponsor-logo-wrap {
    min-height: 190px;
  }
}

.your-company-block {
  padding: clamp(38px, 6vw, 72px);
  border: 1px solid var(--line);
  border-radius: 22px;
  background: rgba(255,255,255,.015);
}

.your-company-block h2 {
  margin: 0 0 18px;
  max-width: 850px;
  font-size: clamp(2.8rem, 6vw, 5.5rem);
  line-height: .94;
  letter-spacing: -.06em;
}

.your-company-block > p:not(.eyebrow) {
  max-width: 680px;
  margin: 0;
  color: var(--muted);
  line-height: 1.75;
}

.partner-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 28px;
}

.partner-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 18px;
  border: 1px solid var(--line);
  font-size: .76rem;
  font-weight: 760;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.partner-button.primary {
  background: var(--text);
  border-color: var(--text);
  color: #040506;
}

.partner-button:hover {
  border-color: var(--accent);
}
</style>
