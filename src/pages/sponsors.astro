---
import Base from '../layouts/Base.astro';

const sponsors = [
  {
    name: 'Arm',
    logo: '/images/sponsors/arm-logo.png',
    support: 'Financial Support · Industry Mentorship',
    description: 'Arm supports Triple Six with financial sponsorship and industry mentors, giving our students opportunities to learn directly from experienced professionals.',
  },
  {
    name: 'ZEISS',
    logo: '/images/sponsors/zeiss-logo.png',
    support: 'Financial Support · Industry Mentorship',
    description: 'ZEISS supports Triple Six with financial sponsorship and industry mentors, giving our students opportunities to learn directly from experienced professionals.',
  },
  {
    name: 'Dave Academy',
    logo: '/images/sponsors/dave-academy-original-clean.png',
    support: 'Registration Support · Mentorship',
    description: 'Dave Academy helped fund our FTC registration costs and supports Triple Six through mentors from their organisation.',
  },
  {
    name: 'Cambridge STEAM Lab',
    logo: '/images/sponsors/cambridge-steam-lab-white.png',
    support: 'Parent Organisation · Mentorship · Financial Support',
    description: 'Cambridge STEAM Lab is our parent organisation. They provide mentors to the team and have supported Triple Six financially.',
  },
  {
    name: 'Canva',
    logo: '/images/sponsors/canva-logo.png',
    support: 'Design Support · Canva Pro',
    description: 'Canva gave Triple Six free Canva Pro, helping us design marketing materials, social media posts, outreach visuals and more.',
  },
];
---
<Base title="Sponsors · Triple Six FTC 26587">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Partners</p>
      <h1>OUR <span class="gradient-text">SPONSORS.</span></h1>
      <p class="lede">The organisations that help make our engineering, competition and outreach possible.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell sponsor-list">
      {sponsors.map((sponsor, index) => (
        <article class="sponsor">
          <div class:list={['sponsor-logo-wrap', { arm: sponsor.name === 'Arm', zeiss: sponsor.name === 'ZEISS' }]}>
            <img src={sponsor.logo} alt={`${sponsor.name} logo`} loading="lazy" />
          </div>
          <div class="sponsor-copy">
            <span class="sponsor-number">{String(index + 1).padStart(2, '0')}</span>
            <p class="support">{sponsor.support}</p>
            <h2>{sponsor.name}</h2>
            <p class="description">{sponsor.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>


  <section class="section fundraiser-section">
    <div class="shell fundraiser-card">
      <div class="fundraiser-logo">
        <img src="/images/sponsors/gofundme-support.svg" alt="GoFundMe" />
      </div>

      <div class="fundraiser-copy">
        <p class="eyebrow">Support Triple Six</p>
        <h2>Help fuel our next season.</h2>
        <p>
          Donations help us fund robot development, competition costs, tools,
          travel and the outreach work that lets us support more young people in STEM.
        </p>
        <a class="fundraiser-button" href="https://www.gofundme.com/f/support-ftc-team-26587-triple-six-for-their-upcoming-seaso" target="_blank" rel="noreferrer">
          Donate on GoFundMe <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell your-company-block">
      <p class="eyebrow">Partner with Triple Six</p>
      <h2>Your company could be on this page.</h2>
      <p>
        Support FTC Team 26587 and your organisation can be recognised alongside
        the partners helping us engineer better robots, compete, and expand our
        outreach. We can feature sponsors on our website, team materials and
        selected outreach communications.
      </p>
      <div class="partner-actions">
        <a class="partner-button primary" href="/contact">Become a sponsor</a>
        <a class="partner-button" href="mailto:triplesixftc@gmail.com">Email us</a>
      </div>
    </div>
  </section>

</Base>

<style>
.sponsor-list {
  display: grid;
  gap: 34px;
}

.sponsor {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(320px, .95fr);
  gap: clamp(36px, 6vw, 88px);
  align-items: center;
  padding-bottom: 72px;
  border-bottom: 1px solid rgba(112,230,129,.12);
}

.sponsor:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.sponsor:nth-child(even) .sponsor-logo-wrap {
  order: 2;
}

.sponsor:nth-child(even) .sponsor-copy {
  order: 1;
}

.sponsor-logo-wrap {
  min-height: 190px;
  position: relative;
  display: grid;
  place-items: center;
  padding: 10px 0;
  background: transparent;
}

.sponsor-logo-wrap img {
  width: min(100%, 620px);
  max-height: 140px;
  object-fit: contain;
}

.sponsor-logo-wrap.arm img {
  width: min(100%, 300px);
  max-height: 150px;
}

.sponsor-logo-wrap.zeiss img {
  width: min(100%, 250px);
  max-height: 185px;
}

.sponsor-logo-wrap::before {
  content: "";
  position: absolute;
  inset: auto 8% 0 8%;
  height: 1px;
  background: var(--accent-gradient);
  opacity: .32;
}

.sponsor-logo-wrap img {
  transition: transform .2s ease, filter .2s ease;
}

.sponsor-logo-wrap:hover img {
  transform: translateY(-2px);
  filter: drop-shadow(0 0 16px rgba(17,207,224,.12));
}

.sponsor-number {
  color: var(--lime);
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .2em;
}

.support {
  margin: 18px 0 10px;
  color: var(--lime);
  font-size: .76rem;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.sponsor h2 {
  margin: 0 0 18px;
  font-size: clamp(3rem, 6vw, 5.5rem);
  line-height: .92;
  letter-spacing: -.06em;
}

.description {
  max-width: 48ch;
  margin: 0;
  color: var(--muted);
  font-size: clamp(1rem, 2vw, 1.12rem);
  line-height: 1.7;
}

@media (max-width: 800px) {
  .sponsor {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .sponsor:nth-child(even) .sponsor-logo-wrap,
  .sponsor:nth-child(even) .sponsor-copy {
    order: initial;
  }

  .sponsor-logo-wrap {
    min-height: 190px;
  }
}

.your-company-block {
  padding: clamp(38px, 6vw, 72px);
  border: 1px solid rgba(112,230,129,.18);
  border-radius: 22px;
  background:
    radial-gradient(circle at 0% 0%, rgba(202,255,50,.045), transparent 32%),
    radial-gradient(circle at 100% 100%, rgba(17,207,224,.04), transparent 34%),
    var(--panel-bg);
}

.your-company-block h2 {
  margin: 0 0 18px;
  max-width: 850px;
  font-size: clamp(2.8rem, 6vw, 5.5rem);
  line-height: .94;
  letter-spacing: -.06em;
}

.your-company-block > p:not(.eyebrow) {
  max-width: 680px;
  margin: 0;
  color: var(--muted);
  line-height: 1.75;
}

.partner-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 28px;
}

.partner-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 18px;
  border: 1px solid var(--line);
  font-size: .76rem;
  font-weight: 760;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.partner-button.primary {
  background: var(--accent-gradient);
  border-color: transparent;
  color: #020506;
}

.partner-button:hover {
  border-color: var(--accent);
}

.fundraiser-card {
  display: grid;
  grid-template-columns: minmax(220px, .8fr) minmax(0, 1.2fr);
  gap: clamp(34px, 7vw, 90px);
  align-items: center;
  padding: clamp(34px, 6vw, 66px);
  border: 1px solid rgba(112,230,129,.18);
  border-radius: 22px;
  background:
    radial-gradient(circle at 0% 0%, rgba(202,255,50,.045), transparent 32%),
    radial-gradient(circle at 100% 100%, rgba(17,207,224,.04), transparent 34%),
    var(--panel-bg);
}

.fundraiser-logo {
  min-height: 190px;
  display: grid;
  place-items: center;
}

.fundraiser-logo img {
  width: min(100%, 390px);
  max-height: 150px;
  object-fit: contain;
}

.fundraiser-copy h2 {
  margin: 0 0 18px;
  font-size: clamp(2.8rem, 6vw, 5.4rem);
  line-height: .94;
  letter-spacing: -.06em;
}

.fundraiser-copy > p:not(.eyebrow) {
  max-width: 600px;
  margin: 0;
  color: var(--muted);
  line-height: 1.75;
}

.fundraiser-button {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 28px;
  min-height: 46px;
  padding: 0 18px;
  border: 1px solid var(--line);
  font-size: .76rem;
  font-weight: 760;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.fundraiser-button span {
  color: var(--accent);
}

.fundraiser-button:hover {
  border-color: var(--accent);
}

@media (max-width: 760px) {
  .fundraiser-card {
    grid-template-columns: 1fr;
  }

  .fundraiser-logo {
    min-height: 130px;
    justify-items: start;
  }

  .fundraiser-logo img {
    max-width: 280px;
  }
}
</style>
