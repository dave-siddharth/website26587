---
import Base from '../layouts/Base.astro';
const sponsors = [
  { name:'Cambridge STEAM Lab', logo:'/images/sponsors/cambridge-steam-lab-white.pngsteam-lab-transparent.png', group:'Parent organisation', contribution:'Mentorship / Financial support', description:'Cambridge STEAM Lab is our parent organisation, provides mentors to the team and has supported Triple Six financially.' },
  { name:'Dave Academy', logo:'/images/sponsors/dave-academy-transparent.png', group:'Supporter', contribution:'Registration support / Mentorship', description:'Dave Academy helped fund our FTC registration costs and supports Triple Six through mentors from their organisation.' },
];
---
<Base title="Sponsors — Triple Six FTC 26587">
  <section class="page-hero">
    <div class="shell">
      <p class="kicker">Sponsors</p>
      <h1>Who backs Triple Six</h1>
      <p class="lede">Every organisation on this page is here because of something they have directly contributed to the team.</p>
      <a class="text-link" href="/contact">Talk to us about supporting the team</a>
    </div>
  </section>

  <section class="section">
    <div class="shell sponsor-list">
      {sponsors.map((sponsor) => (
        <article class="sponsor-row">
          <div class="sponsor-logo"><img src={sponsor.logo} alt={`${sponsor.name} logo`} /></div>
          <div class="sponsor-copy">
            <p class="kicker">{sponsor.group}</p>
            <h2>{sponsor.name}</h2>
            <p class="contribution">{sponsor.contribution}</p>
            <p>{sponsor.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="shell section-heading">
      <div><p class="kicker">Join them</p><h2>There is room on this page</h2></div>
      <div><p class="body-large">Support helps us turn design work into real hardware, enter competitions and keep sharing robotics with others.</p><a class="text-link" href="/contact">Get in touch</a></div>
    </div>
  </section>
</Base>

<style>
.sponsor-list { border-top:1px solid var(--line); }
.sponsor-row { display:grid; grid-template-columns:.9fr 1.1fr; gap:clamp(38px,8vw,100px); align-items:center; padding:58px 0; border-bottom:1px solid var(--line); }
.sponsor-logo { min-height:260px; display:grid; place-items:center; }
.sponsor-logo img { width:min(100%,520px); max-height:230px; object-fit:contain; }
.sponsor-copy h2 { margin:0 0 8px; font-size:clamp(2.4rem,5vw,4.8rem); letter-spacing:-.055em; }
.sponsor-copy .contribution { color:#d6dadd; font-size:1.06rem; margin:0 0 15px; }
.sponsor-copy > p:last-child { margin:0; max-width:50ch; color:var(--muted); line-height:1.75; }
@media(max-width:800px){.sponsor-row{grid-template-columns:1fr}.sponsor-logo{min-height:200px}}
</style>