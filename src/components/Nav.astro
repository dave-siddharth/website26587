---
const links = [
  ['Robots', '/robots'],
  ['Team', '/team'],
  ['Outreach', '/outreach'],
  ['Sponsors', '/sponsors'],
  ['Contact', '/contact'],
];
---
<header class="nav">
  <div class="shell nav-inner">
    <a class="brand" href="/">
      <img src="/images/triple-six-logo.png" alt="Triple Six FTC 26587 logo" />
      <span>TRIPLE SIX <em>26587</em></span>
    </a>

    <nav class="nav-links">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</header>

<style>
.nav {
  position: sticky;
  top: 0;
  z-index: 30;
  border-bottom: 1px solid rgba(255,255,255,.08);
  background: rgba(2,3,5,.88);
  backdrop-filter: blur(18px);
}

.nav-inner {
  min-height: 74px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: .78rem;
  font-weight: 780;
  letter-spacing: .12em;
}

.brand img {
  width: 38px;
  height: 38px;
  object-fit: cover;
  border-radius: 50%;
}

.brand em {
  color: var(--muted);
  font-style: normal;
  font-weight: 650;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: clamp(16px, 2.6vw, 30px);
}

.nav-links a {
  color: var(--muted);
  font-size: .77rem;
  font-weight: 650;
}

.nav-links a:hover {
  color: var(--text);
}

@media (max-width: 760px) {
  .brand span {
    display: none;
  }

  .nav-links {
    gap: 14px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }
}
</style>
