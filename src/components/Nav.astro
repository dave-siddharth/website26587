---
const pathname = Astro.url.pathname;

const robotLinks = [
  { label: 'OUR ROBOTS', href: '/robots' },
  { label: 'BIOBUZZ', href: '/robots/2026-2027' },
  { label: 'DECODE', href: '/robots/2025-2026' },
  { label: 'INTO THE DEEP', href: '/robots/2024-2025' },
];

const resourcesLinks = [
  { label: 'OUR RESOURCES', href: '/resources' },
  { label: 'IMPACT OUTREACH SYSTEM', href: '/resources/impact-outreach-system' },
  { label: 'FIRST LAUNCH', href: '/resources/first-launch' },
];

const sponsorLinks = [
  { label: 'OUR SPONSORS', href: '/sponsors' },
  {
    label: 'GOFUNDME',
    href: 'https://www.gofundme.com/f/support-ftc-team-26587-triple-six-for-their-upcoming-seaso',
    external: true
  },
];

const isActive = (href) => {
  if (href === '/team') return pathname.startsWith('/team');
  if (href === '/awards') return pathname.startsWith('/awards');
  if (href === '/resources') return pathname.startsWith('/resources');
  if (href === '/outreach') return pathname.startsWith('/outreach');
  if (href === '/contact') return pathname.startsWith('/contact');
  if (href === '/robots') return pathname.startsWith('/robots');
  if (href === '/sponsors') return pathname.startsWith('/sponsors');
  return pathname === href;
};
---
<header class="nav">
  <div class="shell nav-inner">
    <a class="brand" href="/">
      <img src="/images/triple-six-logo.png" alt="Triple Six FTC 26587 logo" />
      <span>Triple Six</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a class:list={['nav-link', { active: isActive('/team') }]} href="/team">
        ABOUT
      </a>

      <a class:list={['nav-link', { active: isActive('/awards') }]} href="/awards">
        AWARDS
      </a>

      <div class:list={['nav-dropdown', { active: pathname.startsWith('/resources') }]}>
        <button class="nav-trigger" type="button">
          <span>RESOURCES</span>
          <span class="caret">▼</span>
        </button>

        <div class="nav-menu">
          <p class="nav-menu-heading">OUR RESOURCES</p>
          {resourcesLinks.map((item) => (
            item.external ? (
              <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
            ) : (
              <a href={item.href}>{item.label}</a>
            )
          ))}
        </div>
      </div>

      <div class:list={['nav-dropdown', { active: pathname.startsWith('/robots') }]}>
        <button class="nav-trigger" type="button">
          <span>SEASONS/ROBOTS</span>
          <span class="caret">▼</span>
        </button>

        <div class="nav-menu">
          {robotLinks.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>

      <a class:list={['nav-link', { active: isActive('/outreach') }]} href="/outreach">
        OUTREACH
      </a>

      <div class:list={['nav-dropdown', { active: pathname.startsWith('/sponsors') }]}>
        <button class="nav-trigger" type="button">
          <span>SPONSORS</span>
          <span class="caret">▼</span>
        </button>

        <div class="nav-menu">
          {sponsorLinks.map((item) => (
            item.external ? (
              <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
            ) : (
              <a href={item.href}>{item.label}</a>
            )
          ))}
        </div>
      </div>

      <a class:list={['nav-link', { active: isActive('/contact') }]} href="/contact">
        CONTACT
      </a>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme" title="Switch light / dark mode">
        <span class="theme-icon theme-icon-sun" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
        </span>
        <span class="theme-icon theme-icon-moon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M20.5 14.2A8.2 8.2 0 0 1 9.8 3.5 8.7 8.7 0 1 0 20.5 14.2Z"></path>
          </svg>
        </span>
        <span class="sr-only">Toggle light and dark mode</span>
      </button>
    </nav>
  </div>
</header>

<style>
.nav {
  position: sticky;
  top: 0;
  z-index: 40;
  background: linear-gradient(180deg, var(--nav-bg-1), var(--nav-bg-2));
  border-bottom: 1px solid var(--nav-border);
  backdrop-filter: blur(18px);
}

.nav-inner {
  min-height: 84px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  color: var(--text);
}

.brand img {
  width: 44px;
  height: 44px;
  object-fit: cover;
  border-radius: 50%;
}

.brand span {
  font-size: clamp(1rem, 2vw, 1.22rem);
  font-weight: 760;
  letter-spacing: -.02em;
}

.nav-links {
  display: flex;
  align-items: stretch;
  gap: clamp(4px, .8vw, 12px);
}

.nav-link,
.nav-trigger {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 84px;
  padding: 0 11px;
  border: 0;
  background: transparent;
  color: var(--nav-text);
  font-size: .82rem;
  font-weight: 760;
  letter-spacing: .075em;
  text-transform: uppercase;
  cursor: pointer;
}

.nav-link::after,
.nav-trigger::after {
  content: "";
  position: absolute;
  left: 9px;
  right: 9px;
  bottom: 0;
  height: 3px;
  background: linear-gradient(90deg, #caff32 0%, #70e681 48%, #11cfe0 100%);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .18s ease;
}

.nav-link:hover::after,
.nav-dropdown:hover .nav-trigger::after,
.nav-link.active::after,
.nav-dropdown.active .nav-trigger::after {
  transform: scaleX(1);
}

.nav-dropdown {
  position: relative;
  display: inline-flex;
}

.caret {
  background: linear-gradient(90deg, #caff32, #70e681, #11cfe0);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-size: .58rem;
  transform: translateY(-1px);
}

.nav-menu {
  position: absolute;
  top: calc(100% - 1px);
  left: 0;
  min-width: 250px;
  display: grid;
  padding: 12px 0;
  border: 1px solid rgba(112,230,129,.14);
  background:
    radial-gradient(circle at 100% 0%, rgba(17,207,224,.06), transparent 38%),
    var(--nav-menu-bg);
  box-shadow: 0 20px 44px rgba(0,0,0,.40);
  opacity: 0;
  visibility: hidden;
  transform: translateY(6px);
  transition: opacity .16s ease, visibility .16s ease, transform .16s ease;
}

.nav-dropdown:hover .nav-menu,
.nav-dropdown:focus-within .nav-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.nav-menu-heading {
  margin: 4px 18px 10px;
  color: var(--muted);
  font-size: .68rem;
  font-weight: 820;
  letter-spacing: .15em;
  text-transform: uppercase;
}

.nav-menu a {
  position: relative;
  padding: 12px 18px;
  color: var(--nav-text);
  font-size: .8rem;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.nav-menu a:hover {
  background: linear-gradient(90deg, rgba(202,255,50,.055), rgba(17,207,224,.04));
}

.nav-menu a:hover::after {
  content: "";
  position: absolute;
  inset: auto 18px 5px 18px;
  height: 1px;
  background: linear-gradient(90deg, #caff32, #70e681, #11cfe0);
}

.theme-toggle {
  align-self: center;
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  margin: 21px 0 0 4px;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--panel-bg);
  color: var(--nav-text);
  cursor: pointer;
  transition: border-color .18s ease, transform .18s ease, background .18s ease;
}

.theme-toggle:hover {
  transform: translateY(-1px);
  border-color: rgba(112,230,129,.45);
  background:
    linear-gradient(var(--panel-bg), var(--panel-bg)) padding-box,
    var(--accent-gradient) border-box;
}

.theme-icon {
  grid-area: 1 / 1;
  display: grid;
  place-items: center;
  transition: opacity .16s ease, transform .16s ease;
}

.theme-icon svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

:global(html[data-theme="dark"]) .theme-icon-sun {
  opacity: 1;
  transform: scale(1);
}

:global(html[data-theme="dark"]) .theme-icon-moon {
  opacity: 0;
  transform: scale(.72);
}

:global(html[data-theme="light"]) .theme-icon-sun {
  opacity: 0;
  transform: scale(.72);
}

:global(html[data-theme="light"]) .theme-icon-moon {
  opacity: 1;
  transform: scale(1);
}

@media (max-width: 1080px) {
  .nav-inner {
    min-height: auto;
    padding: 14px 0;
    align-items: flex-start;
    flex-direction: column;
  }

  .nav-links {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-link,
  .nav-trigger {
    min-height: 56px;
    white-space: nowrap;
  }

  .theme-toggle {
    flex: 0 0 42px;
    margin: 7px 0 0 4px;
  }
}

@media (max-width: 560px) {
  .brand span {
    font-size: 1rem;
  }

  .brand img {
    width: 38px;
    height: 38px;
  }
}
</style>


<script>
  const themeToggle = document.querySelector('[data-theme-toggle]');

  if (themeToggle) {
    const root = document.documentElement;

    const syncThemeButton = () => {
      const current = root.dataset.theme === 'light' ? 'light' : 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      themeToggle.setAttribute('aria-label', `Switch to ${next} mode`);
      themeToggle.setAttribute('title', `Switch to ${next} mode`);
    };

    syncThemeButton();

    themeToggle.addEventListener('click', () => {
      const current = root.dataset.theme === 'light' ? 'light' : 'dark';
      const next = current === 'dark' ? 'light' : 'dark';

      root.dataset.theme = next;
      root.style.colorScheme = next;

      try {
        localStorage.setItem('triple-six-theme', next);
      } catch (_) {}

      syncThemeButton();
    });
  }
</script>
