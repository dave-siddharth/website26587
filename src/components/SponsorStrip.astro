---
const { compact = false } = Astro.props;
---

<section class:list={['sponsor-strip', { compact }]} aria-label="Team sponsors">
  <div class="shell sponsor-strip-inner">
    <p>Supported by</p>

    <div class="sponsor-strip-logos">
      <a class="strip-logo arm" href="/sponsors" aria-label="Arm">
        <img src="/images/sponsors/arm-logo.png" alt="Arm" />
      </a>

      <a class="strip-logo zeiss" href="/sponsors" aria-label="ZEISS">
        <img src="/images/sponsors/zeiss-logo.png" alt="ZEISS" />
      </a>

      <a class="strip-logo skyscanner" href="/sponsors" aria-label="Skyscanner">
        <img src="/images/sponsors/skyscanner-logo.png" alt="Skyscanner" />
      </a>

      <a class="strip-logo pcbway" href="/sponsors" aria-label="PCBWay">
        <img src="/images/sponsors/pcbway-logo.png" alt="PCBWay" />
      </a>

      <a class="strip-logo plex" href="/sponsors" aria-label="PLEX">
        <img src="/images/sponsors/plex-logo.png" alt="PLEX" />
      </a>

      <a class="strip-logo dave" href="/sponsors" aria-label="Dave Academy">
        <img src="/images/sponsors/dave-academy-original-clean.png" alt="Dave Academy" />
      </a>

      <a class="strip-logo steam" href="/sponsors" aria-label="Cambridge STEAM Lab">
        <img src="/images/sponsors/cambridge-steam-lab-white.png" alt="Cambridge STEAM Lab" />
      </a>

      <a class="strip-logo canva" href="/sponsors" aria-label="Canva">
        <img src="/images/sponsors/canva-logo.png" alt="Canva" />
      </a>
      <a class="strip-logo frctees" href="/sponsors" aria-label="FRC Tees">
        <img src="/images/sponsors/frctees-logo.png" alt="FRC Tees" />
      </a>
    </div>

    <a class="strip-link" href="/sponsors">Our sponsors <span>→</span></a>
  </div>
</section>

<style>
.sponsor-strip {
  position: relative;
  color: var(--text);
  border-top: 1px solid var(--line-soft);
  border-bottom: 1px solid var(--line-soft);
  background: var(--surface-0);
}

.sponsor-strip::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 1px;
  background: var(--accent-gradient);
  opacity: .48;
}

.sponsor-strip-inner {
  min-height: 104px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 24px;
  align-items: center;
}

.sponsor-strip.compact .sponsor-strip-inner {
  min-height: 108px;
}

.sponsor-strip-inner > p {
  margin: 0;
  color: var(--muted);
  font-size: .68rem;
  font-weight: 720;
  letter-spacing: .14em;
  text-transform: uppercase;
  white-space: nowrap;
}

.sponsor-strip-logos {
  display: flex;
  align-items: center;
  gap: 16px;
  min-width: 0;
}

.strip-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54px;
  padding: 0;
  transition: transform .18s ease, filter .18s ease;
}

.strip-logo:hover {
  transform: translateY(-2px);
  filter: drop-shadow(0 0 12px rgba(17,207,224,.14));
}

.strip-logo img {
  display: block;
  width: auto;
  height: auto;
  object-fit: contain;
}

.strip-logo.arm img {
  width: auto;
  max-width: 78px;
  max-height: 38px;
}

.strip-logo.zeiss img {
  width: auto;
  max-width: 56px;
  max-height: 44px;
}

.strip-logo.skyscanner img {
  width: auto;
  max-width: 124px;
  max-height: 36px;
}

.strip-logo.pcbway img {
  width: auto;
  max-width: 106px;
  max-height: 39px;
}

.strip-logo.plex img {
  width: auto;
  max-width: 96px;
  max-height: 42px;
}

.strip-logo.dave img {
  width: auto;
  max-width: 88px;
  max-height: 52px;
}

.strip-logo.steam img {
  width: auto;
  max-width: 142px;
  max-height: 40px;
}

.strip-logo.canva img {
  width: auto;
  max-width: 104px;
  max-height: 37px;
}

.strip-logo.frctees img {
  width: auto;
  max-width: 122px;
  max-height: 40px;
}

.strip-link {
  color: var(--muted);
  font-size: .76rem;
  white-space: nowrap;
}

.strip-link span {
  background: var(--accent-gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* Cambridge STEAM Lab asset is white, so flip it for the light theme. */
:global(html[data-theme="light"]) .strip-logo.steam img {
  filter: brightness(0.16);
}

@media (max-width: 1040px) {
  .sponsor-strip-inner {
    grid-template-columns: 1fr;
    gap: 10px;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  .sponsor-strip-logos {
    flex-wrap: wrap;
    gap: 12px 16px;
  }

  .strip-link {
    width: fit-content;
  }
}
</style>
